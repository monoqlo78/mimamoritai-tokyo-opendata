@page "/devices/{DeviceId:guid}"
@rendermode InteractiveServer
@using MimamoriTai.Core.Abstractions
@using MimamoriTai.Core.Application
@using MimamoriTai.Core.Domain
@using MimamoriTai.Web.Services
@inject DeviceDetailService DeviceDetailReadModel
@inject DeviceInsightQuestionService Insight
@inject DeviceControlService Control
@inject DeviceSettingsService Settings
@inject PowerUsageService PowerUsage
@inject ActivityService Activity
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(_model is null ? "デバイス詳細" : _model.Name) / 見守り隊</PageTitle>

<header class="topbar">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true">み</span>
        <div>
            <h1>@(_model?.Name ?? "デバイス詳細")</h1>
            <p>@(_model is null ? "デバイスの詳しい情報" : $"{_model.Room} ・ {DeviceTypeLabel(_model.DeviceType)}")</p>
        </div>
    </div>
    <div class="topbar-actions">
        <a class="ghost small" href="/">← ダッシュボードに戻る</a>
    </div>
</header>

@if (_notFoundOrDenied)
{
    <div class="notice notice-warn" role="status" aria-live="polite">
        <span class="notice-icon">⚠</span>
        <span>このデバイスは見つからないか、閲覧する権限がありません。</span>
    </div>
}
else if (_model is null)
{
    <p class="loading">読み込み中…</p>
}
else
{
    @if (_notice is not null)
    {
        <div class="notice notice-@_noticeKind" role="status" aria-live="polite">
            <span class="notice-icon">@(_noticeKind == "ok" ? "✓" : _noticeKind == "blocked" ? "⛔" : "⚠")</span>
            <span>@_notice</span>
            <button class="notice-close" @onclick="() => _notice = null" aria-label="閉じる">✕</button>
        </div>
    }

    @if (_busy)
    {
        <div class="busy-bar" role="status" aria-live="polite">処理中…</div>
    }

    @if (!_model.IsActive)
    {
        <div class="notice notice-warn" role="status">
            <span class="notice-icon">⚠</span>
            <span>この機器は現在システムに接続されていません（無効化済み）。過去の記録のみ表示しています。</span>
        </div>
    }

    <section class="status-card @(_model.IsStateKnown && _model.IsOn && !IsStandingBy() ? "risk-low" : "")">
        <div class="status-icon" aria-hidden="true">@(!_model.IsStateKnown ? "？" : IsStandingBy() ? "―" : _model.IsOn ? "✓" : "―")</div>
        <div class="status-copy">
            <p class="eyebrow">現在の状態</p>
            <h2>@(!_model.IsStateKnown ? "わかりません" : IsStandingBy() ? "待機中" : _model.IsOn ? "使用中" : "停止中")</h2>
            @if (IsStandingBy())
            {
                <p class="standby-note">スイッチは入っていますが、電気は使われていません。つないだ家電の電源が切れているか、コンセントが抜けている可能性があります。</p>
            }
            <p class="status-reason">
                @if (_model.PowerWatts is { } watts)
                {
                    @($"消費電力 約{watts:0.#}W ・ ")
                }
                @if (!_model.IsStateKnown)
                {
                    @("機器から状態を受け取れていません。ハブの接続を確認してください")
                }
                else
                {
                    @($"最終確認 {FormatLocal(_model.StatusObservedAtUtc)}")
                    @(_model.IsStateLive ? "" : "（記録からの表示）")
                }
            </p>
        </div>
        <div class="device-actions">
            <button class="secondary-button"
                    title="@(_model.SafetyClass switch { "Restricted" => "この機器は遠隔でONにしない設定です", "Guarded" => "周囲の安全を確認したうえでONにします", _ => "ONにする" })"
                    @onclick="@(() => ControlAsync(DeviceAction.TurnOn))"
                    disabled="@(_busy || !_model.IsEnabled)">つける</button>
            <button class="secondary-button"
                    @onclick="@(() => ControlAsync(DeviceAction.TurnOff))"
                    disabled="@(_busy || !_model.IsEnabled)">消す</button>
        </div>
    </section>
    @if (!_model.RemoteControlAllowed)
    {
        <p class="restricted-note">この機器は遠隔操作が許可されていません。下の「遠隔操作を許可する」をオンにしてください</p>
    }
    else if (_model.SafetyClass == "Restricted")
    {
        <p class="restricted-note">安全のため、遠隔では消す操作だけできます</p>
    }
    else if (_model.SafetyClass == "Guarded")
    {
        <p class="restricted-note">火や熱をあつかう機器です。ONにする前に周囲の確認をお願いします（ご家族全員に通知されます）</p>
    }

    <section class="permission-card">
        <h3>この機器の設定</h3>

        @if (_model.DataSourceMode == DataSourceMode.Sample)
        {
            <p class="permission-hint">デモデータの機器のため変更できません。</p>
        }
        else
        {
            <div class="permission-row rename-row">
                <span class="rename-copy">
                    <strong>呼び名と部屋</strong>
                    <small>
                        画面・LINE・AIの返事すべてでこの名前を使います。「リビングの電気」のように、
                        普段そう呼んでいる言葉にしてください（メーカーの型番のままだと呼びかけても見つかりません）。
                        部屋は空欄でもかまいません。
                    </small>
                    <span class="rename-input">
                        <input type="text" maxlength="60" placeholder="リビングの電気"
                               aria-label="呼び名"
                               value="@_nameDraft"
                               disabled="@_busy"
                               @oninput="@(e => _nameDraft = e.Value?.ToString() ?? "")" />
                        <input type="text" maxlength="64" placeholder="部屋（例：寝室）"
                               aria-label="部屋"
                               value="@_roomDraft"
                               disabled="@_busy"
                               @oninput="@(e => _roomDraft = e.Value?.ToString() ?? "")" />
                        <button class="secondary-button"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_nameDraft) || !HasNamingChanges)"
                                @onclick="SaveNamingAsync">保存</button>
                    </span>
                    <small class="muted">
                        機器そのものの名前は「@_model.ProviderName」です（SwitchBot側の名前。変わりません）。
                    </small>
                </span>
            </div>

            <label class="permission-row">
                <input type="checkbox"
                       checked="@_model.RemoteControlAllowed"
                       disabled="@_busy"
                       @onchange="@(e => UpdatePermissionAsync((bool)e.Value!, _model.SafetyClass == "Safe", _model.SafetyClass == "Restricted"))" />
                <span>
                    <strong>この機器の遠隔操作を許可する</strong>
                    <small>オフの間は「つける」「消す」の両方が拒否されます。</small>
                </span>
            </label>

            <label class="permission-row @(_model.RemoteControlAllowed ? "" : "is-disabled")">
                <input type="checkbox"
                       checked="@(_model.SafetyClass == "Restricted")"
                       disabled="@(_busy || !_model.RemoteControlAllowed)"
                       @onchange="@(e => UpdatePermissionAsync(_model.RemoteControlAllowed, false, (bool)e.Value!))" />
                <span>
                    <strong>遠隔でONにすることを禁止する</strong>
                    <small>
                        チェックすると、確認を挟んでもONにはできません（OFFは可能です）。
                        ご本人が近くにいないときに絶対に通電させたくない機器に使ってください。
                    </small>
                </span>
            </label>

            <label class="permission-row @(_model.RemoteControlAllowed && _model.SafetyClass != "Restricted" ? "" : "is-disabled")">
                <input type="checkbox"
                       checked="@(_model.SafetyClass == "Safe")"
                       disabled="@(_busy || !_model.RemoteControlAllowed || _model.SafetyClass == "Restricted")"
                       @onchange="@(e => UpdatePermissionAsync(_model.RemoteControlAllowed, (bool)e.Value!, false))" />
                <span>
                    <strong>確認なしでONにできる機器として扱う</strong>
                    <small>
                        照明や扇風機など、留守中にONになっても危険がない機器のみチェックしてください。
                        暖房器具・調理器具はオフのままにしてください。周囲の安全を確認してからONにでき、
                        実行するとご家族全員にお知らせが届きます。
                    </small>
                </span>
            </label>
        }
    </section>

    <div class="today-summary">
        <div class="summary-item">
            <span>今日 電源が入った回数</span>
            <strong>@_model.TodayUsageCount 回</strong>
        </div>
        <div class="summary-item">
            <span>直近@(_model.PeriodDays)日間の合計</span>
            <strong>@_model.PeriodUsageCount 回</strong>
        </div>
        <div class="summary-item">
            <span>1日あたりの平均</span>
            <strong>@_model.AveragePerDay.ToString("0.#") 回</strong>
        </div>
    </div>

    <section class="primary-grid">
        <article class="card">
            <p class="eyebrow">最近の動き</p>
            <h2>イベント履歴</h2>
            @if (_model.Timeline.Count == 0)
            {
                <p class="empty-state">まだ記録がありません</p>
            }
            else
            {
                <ul class="timeline">
                @foreach (var item in _model.Timeline.Take(15))
                {
                    <li>
                        <span class="time">@FormatLocal(item.OccurredAtUtc)</span>
                        <span>
                            @EventTypeLabel(item.EventType)
                            @if (item.NumericValue is { } value)
                            {
                                @($"（{value:0.#}{item.Unit}）")
                            }
                        </span>
                        <span class="state @item.State">@StateLabel(item.State)</span>
                    </li>
                }
                </ul>
            }
        </article>

        <article class="card">
            <p class="eyebrow">Fabric インサイト</p>
            <h2>利用傾向</h2>
            @if (_insightLoading)
            {
                <p class="muted">分析中…</p>
            }
            else if (_insight is not null)
            {
                <p>@_insight.Answer</p>
                <span class="chip @(_insight.Source == "Fabric" ? "on" : "mock")">
                    @(_insight.Source == "Fabric" ? "Fabric" : "ローカル集計")
                </span>
            }
            else
            {
                <p class="muted">インサイトを準備しています…</p>
            }
        </article>
    </section>

    <details class="detail-panel">
        <summary>
            <span>使用電力量</span>
            <span class="summary-meta">
                @if (_power.HasData)
                {
                    @($"最終計測 {HouseholdTime.LocalTime(_power.MeasuredAtUtc!.Value):HH\\:mm}")
                }
                else if (DayProfileTotal() > 0)
                {
                    @("日ごとの集計は準備中")
                }
                else
                {
                    @("計測値なし")
                }
            </span>
        </summary>
        <div class="detail-content">
            @if (!_power.HasData)
            {
                @* Only Plug Mini class devices meter power, so this is the normal state
                   for a light or an air conditioner rather than an error. When the hourly
                   profile does have watt-hours, saying "not metered" here would flatly
                   contradict the chart below it, so point at that chart instead. *@
                @if (DayProfileTotal() > 0)
                {
                    <p class="empty-state">
                        1日ごとの電力量はまだ数えられていません。下の「この24時間の電気の使いかた」をご覧ください。
                    </p>
                }
                else
                {
                    <p class="empty-state">この機器は電力を計測していません</p>
                }
            }
            else
            {
                <ul class="power-figures">
                    <li>
                        <span class="power-label">今日</span>
                        <span class="power-value">@PowerUsageService.Format(_power.TodayWh)</span>
                    </li>
                    <li>
                        <span class="power-label">昨日</span>
                        <span class="power-value">@PowerUsageService.Format(_power.YesterdayWh)</span>
                    </li>
                    <li>
                        <span class="power-label">過去1週間</span>
                        <span class="power-value">@PowerUsageService.Format(_power.Last7DaysWh)</span>
                    </li>
                    <li>
                        <span class="power-label">過去1カ月</span>
                        <span class="power-value">@PowerUsageService.Format(_power.Last30DaysWh)</span>
                    </li>
                </ul>

                @* The watt-hours alone mean nothing to a family; what they can act on is
                   whether today departs from this home's own routine. *@
                @if (_power.Headline.Trend != PowerUsageTrend.Unknown)
                {
                    <p class="power-trend @TrendClass(_power.Headline.Trend)">
                        <span class="power-trend-word">@TrendWord(_power.Headline.Trend)</span>
                        <span class="power-trend-detail">@TrendDetail(_power.Headline)</span>
                    </p>
                }

                <BarChart Points="PowerBars()" Unit="Wh"
                          AriaLabel="@PowerBarsAriaLabel()" Class="device-trend" />
            }
        </div>
    </details>

    <details class="detail-panel" open>
        <summary>
            <span>この24時間の電気の使いかた</span>
            <span class="summary-meta">合計 @DayProfileTotal().ToString("0.#") Wh</span>
        </summary>
        <div class="detail-content">
            @* 電力・電圧・電流の生の推移は、プラグが同じ値を返し続けた回は観測として数え
               られないため点がまばらになる。時間ごとに束ねたこの棒なら、観測が少ない時間
               も「その時間は電気を使っていない」として同じ幅で並ぶので、家族が読める。 *@
            @if (_dayProfile is null || _dayProfile.TotalWh <= 0)
            {
                <p class="empty-state">この24時間は、この家電の電気が記録されていません</p>
            }
            else
            {
                <DayProfileChart Hours="_dayProfile.Hours" StartHour="_dayProfileStartHour"
                                 CurrentHour="CurrentLocalHour()" ShowLegend="false"
                                 AriaLabel="@($"{_model.Name}のこの24時間の電気の使いかた")" />

                <p class="chart-note">
                    1本が1時間ぶんの電気の量（Wh）です。うすい帯は0時から6時のあいだを表します。
                </p>
            }
        </div>
    </details>

    @if (_telemetry.Count > 0)
    {
        <details class="detail-panel">
            <summary>
                <span>電力・電圧・電流の推移</span>
                <span class="summary-meta">直近@(PowerUsageService.TelemetryHours)時間</span>
            </summary>
            <div class="detail-content">
                @* Three separate charts rather than one with three lines: watts, volts and
                   milliamps span wildly different magnitudes (0.3W against 104V against
                   314mA), so plotting them together would flatten two of them into the
                   axis. Each keeps its own scale and says what that scale is. *@
                <SparkLine Points="Series(s => s.Watts)" Caption="消費電力"
                           Current="@Latest(s => s.Watts, "W", 1)" Unit="W" Decimals="1"
                           Summary="@SeriesSummary(s => s.Watts, "W", 1)"
                           AriaLabel="@SeriesAriaLabel("消費電力", s => s.Watts, "ワット")"
                           Class="device-spark" />

                <SparkLine Points="Series(s => s.CurrentMa)" Caption="電流"
                           Current="@Latest(s => s.CurrentMa, "mA", 0)" Unit="mA" Decimals="0"
                           Summary="@SeriesSummary(s => s.CurrentMa, "mA", 0)"
                           AriaLabel="@SeriesAriaLabel("電流", s => s.CurrentMa, "ミリアンペア")"
                           Class="device-spark" />

                <SparkLine Points="Series(s => s.VoltageV)" Caption="電圧"
                           Current="@Latest(s => s.VoltageV, "V", 1)" Unit="V" Decimals="1"
                           Summary="@SeriesSummary(s => s.VoltageV, "V", 1)"
                           AriaLabel="@SeriesAriaLabel("電圧", s => s.VoltageV, "ボルト")"
                           Class="device-spark" />

                @* Voltage is the supply, not the resident: it barely moves and says
                   nothing about whether anyone is home. Saying so stops a family reading
                   a flat line as a broken sensor. *@
                <p class="chart-note">
                    消費電力と電流は家電の使われ方、電圧は電力会社から届いている電気の状態を表します。
                    電圧はほとんど変わらないのが正常です。
                    プラグが前と同じ値を送ってきた回は、測り直せたとは限らないので点にしていません。
                    そのため点はとびとびになります。
                </p>
            </div>
        </details>
    }

    <details class="detail-panel" open>
        <summary>
            <span>直近@(_model.PeriodDays)日間に電源が入った回数</span>
            <span class="summary-meta">1日あたり平均 @_model.AveragePerDay.ToString("0.#") 回</span>
        </summary>
        <div class="detail-content">
            @if (_model.DailyBreakdown.Count == 0)
            {
                <p class="empty-state">まだ記録がありません</p>
            }
            else
            {
                @* Scaled against the busiest day: the old fixed 12px-per-use bar hit its
                   200px cap at 17 uses, so every busy day looked identical. *@
                <BarChart Points="UsageBars()" Unit="回"
                          AriaLabel="@UsageBarsAriaLabel()" Class="device-trend" />

                <ul class="history">
                    @foreach (var day in _model.DailyBreakdown.AsEnumerable().Reverse())
                    {
                        <li>
                            <span class="date">@day.Date.ToString("M/d")</span>
                            <span class="muted">@day.OnCount 回</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </details>
}

@code {
    [Parameter] public Guid DeviceId { get; set; }

    private DeviceDetailModel? _model;
    private PowerUsageSummary _power = PowerUsageSummary.Empty;
    private IReadOnlyList<PlugSample> _telemetry = [];
    private DeviceHourlyEnergy? _dayProfile;
    private int _dayProfileStartHour;
    private FabricAnswer? _insight;
    private bool _insightLoading;
    private bool _notFoundOrDenied;
    private bool _busy;
    private string? _notice;
    private string _noticeKind = "ok";
    private Guid _loadedDeviceId;
    private string _nameDraft = string.Empty;
    private string _roomDraft = string.Empty;

    // 15s keeps a single appliance feeling live without burning through SwitchBot's
    // daily API allowance (one status read per tick, only while the page is open).
    private static readonly TimeSpan LiveRefreshInterval = TimeSpan.FromSeconds(15);
    private readonly CancellationTokenSource _refreshCts = new();
    private PeriodicTimer? _refreshTimer;

    private bool HasNamingChanges =>
        _model is not null
        && (_nameDraft.Trim() != _model.Name || (_roomDraft.Trim() != _model.Room));

    /// <summary>Oldest day on the left, so the chart reads left-to-right like a calendar.</summary>
    private IReadOnlyList<BarChartPoint> UsageBars()
    {
        if (_model is null)
        {
            return [];
        }

        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);

        return [.. _model.DailyBreakdown.Select(d =>
            new BarChartPoint(d.Date.ToString("M/d"), d.OnCount, d.Date == today))];
    }

    private string UsageBarsAriaLabel()    {
        if (_model is null || _model.DailyBreakdown.Count == 0)
        {
            return "電源が入った回数の記録はまだありません";
        }

        var parts = _model.DailyBreakdown.Select(d => $"{d.Date:M月d日} {d.OnCount}回");
        return $"日ごとに電源が入った回数：{string.Join("、", parts)}";
    }

    /// <summary>
    /// The last fortnight of the 30-day series: a month of daily bars squeezed into a
    /// phone-width card leaves each one about a pixel wide, which reads as noise. The
    /// monthly figure above the chart is what carries that window.
    /// </summary>
    private IReadOnlyList<BarChartPoint> PowerBars()
    {
        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);

        return [.. _power.Daily
            .Where(d => d.Date >= today.AddDays(-13))
            .Select(d => new BarChartPoint(
                d.Date.ToString("M/d"), d.EnergyWh, d.Date == today,
                PowerUsageService.Format(d.EnergyWh)))];
    }

    private string PowerBarsAriaLabel()
    {
        if (!_power.HasData)
        {
            return "電力量の記録はまだありません";
        }

        return "日ごとの使用電力量："
            + string.Join("、", PowerBars().Select(p => $"{p.Label} {p.Display}"));
    }

    /// <summary>
    /// One measured quantity as a chartable series, dropping the samples where the plug
    /// reported nothing. Those are left out rather than plotted as zero: a missing
    /// reading would otherwise draw a spike down to the axis that never happened.
    /// </summary>
    private IReadOnlyList<SparkPoint> Series(Func<PlugSample, double?> pick) =>
        [.. _telemetry
            .Where(s => pick(s) is not null)
            .Select(s => new SparkPoint(HouseholdTime.ToLocal(s.At), pick(s)!.Value))];

    private string Latest(Func<PlugSample, double?> pick, string unit, int decimals)
    {
        var value = _telemetry.LastOrDefault(s => pick(s) is not null);
        return value is null ? "—" : $"{pick(value)!.Value.ToString($"F{decimals}")} {unit}";
    }

    /// <summary>
    /// Screen readers get the shape of the series rather than every sample: 288 readings
    /// read aloud is unusable, while "between X and Y, now Z" is the same conclusion a
    /// sighted reader draws from the line.
    /// </summary>
    private string SeriesAriaLabel(string name, Func<PlugSample, double?> pick, string unit)
    {
        var points = Series(pick);
        if (points.Count == 0)
        {
            return $"{name}の記録はまだありません";
        }

        var min = points.Min(p => p.Value);
        var max = points.Max(p => p.Value);
        var now = points[^1].Value;

        return $"{name}の推移：最小 {min:0.#}{unit}、最大 {max:0.#}{unit}、最新 {now:0.#}{unit}";
    }

    /// <summary>
    /// The same figures in words under the plot.
    ///
    /// A plug that repeats its last status leaves only a handful of observations in a
    /// day, and a chart with four ticks on it reads as a broken sensor rather than as a
    /// quiet appliance. The numbers are what the family actually came for, so they are
    /// stated outright instead of being left to be read off a line that may not be there.
    /// </summary>
    private string SeriesSummary(Func<PlugSample, double?> pick, string unit, int decimals)
    {
        var points = Series(pick);
        if (points.Count == 0)
        {
            return string.Empty;
        }

        var format = $"F{decimals}";
        var min = points.Min(p => p.Value).ToString(format);
        var max = points.Max(p => p.Value).ToString(format);

        return $"いちばん高いとき {max}{unit} ・ いちばん低いとき {min}{unit} ・ 記録できた回数 {points.Count}回";
    }

    /// <summary>Watt-hours this appliance drew across the rolling 24-hour window.</summary>
    private double DayProfileTotal() => _dayProfile?.TotalWh ?? 0;

    private static int CurrentLocalHour() => HouseholdTime.ToLocal(DateTimeOffset.UtcNow).Hour;

    private static string TrendWord(PowerUsageTrend trend) => trend switch
    {
        PowerUsageTrend.Higher => "いつもより多め",
        PowerUsageTrend.Lower => "いつもより少なめ",
        _ => "ほぼいつもどおり"
    };

    private static string TrendClass(PowerUsageTrend trend) => trend switch
    {
        PowerUsageTrend.Higher => "is-higher",
        PowerUsageTrend.Lower => "is-lower",
        _ => "is-typical"
    };

    /// <summary>
    /// Spells out what the comparison was made against, because "少なめ" on its own
    /// invites the family to wonder whether the app simply lost the data.
    /// </summary>
    private static string TrendDetail(PowerUsageComparison c)
    {
        var baseline = $"いつも約{PowerUsageService.Format(c.Baseline)}／直近{c.BaselineDays}日";

        return c.Ratio is { } r
            ? $"（{baseline}の約{r * 100:0}%）"
            : $"（{baseline}）";
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    /// <summary>
    /// Handles navigating directly between two device detail pages (e.g. via browser
    /// back/forward or an in-app link) without a full circuit reconnect, matching
    /// Blazor Server's routing model where OnInitializedAsync only runs once per circuit.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (DeviceId != _loadedDeviceId)
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync(bool includeInsight = true)
    {
        _loadedDeviceId = DeviceId;
        _model = await DeviceDetailReadModel.LoadAsync(DeviceId);
        _notFoundOrDenied = _model is null;
        _nameDraft = _model?.Name ?? string.Empty;
        _roomDraft = _model?.Room ?? string.Empty;

        // Sequential, not concurrent: both reads share this circuit's DbContext, which
        // cannot serve two operations at once.
        _power = _model is null
            ? PowerUsageSummary.Empty
            : await PowerUsage.GetAsync(_model.HouseholdId, DeviceId);

        _telemetry = _model is null
            ? []
            : await PowerUsage.GetTelemetryAsync(_model.HouseholdId, DeviceId);

        // The household profile is reused rather than a per-device query added: the
        // dashboard already builds this, and the split per appliance comes with it.
        if (_model is null)
        {
            _dayProfile = null;
        }
        else
        {
            var profile = await Activity.GetHourlyEnergyAsync(_model.HouseholdId, 14);
            _dayProfileStartHour = profile.StartHour;
            _dayProfile = profile.TodayByDevice.FirstOrDefault(d => d.DeviceId == DeviceId);
        }

        if (!includeInsight)
        {
            return;
        }

        _insight = null;

        if (_model is not null)
        {
            // Deferred so the bounded-timeout Fabric call (or its local fallback) never
            // delays the initial page render - the panel shows a loading state until it resolves.
            _ = LoadInsightAsync(_model.HouseholdId, DeviceId);
        }
    }

    /// <summary>
    /// True when the relay is on but no power is flowing. The family reads 使用中 as a sign
    /// that someone is up and about, so a plug left switched on with nothing running behind
    /// it must not claim that. Null wattage means the hub reported none - stay quiet then.
    /// </summary>
    private bool IsStandingBy() =>
        _model is { IsStateKnown: true, IsOn: true, PowerWatts: <= 0 };

    /// <summary>
    /// Re-reads the appliance while the page stays open, so flipping the physical switch
    /// on the device itself is reflected here instead of leaving a stale "使用中"/"停止中"
    /// until the family reloads the page. The usage insight is deliberately not refetched:
    /// it is an AI call, and only the on/off state changes this often.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _refreshTimer is not null)
        {
            return;
        }

        _refreshTimer = new PeriodicTimer(LiveRefreshInterval);
        _ = RefreshLoopAsync(_refreshTimer, _refreshCts.Token);
        await Task.CompletedTask;
    }

    private async Task RefreshLoopAsync(PeriodicTimer timer, CancellationToken ct)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                // Never refresh mid-edit: it would overwrite what the family is typing,
                // and never while a command is in flight, because the shared DbContext
                // cannot serve two operations at once.
                if (_busy || HasNamingChanges)
                {
                    continue;
                }

                await InvokeAsync(async () =>
                {
                    await ReloadAsync(includeInsight: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Page closed.
        }
        catch (ObjectDisposedException)
        {
            // Circuit torn down between ticks.
        }
    }

    public ValueTask DisposeAsync()
    {
        _refreshCts.Cancel();
        _refreshTimer?.Dispose();
        _refreshCts.Dispose();
        return ValueTask.CompletedTask;
    }

    private async Task LoadInsightAsync(Guid householdId, Guid deviceId)
    {
        _insightLoading = true;
        StateHasChanged();

        try
        {
            _insight = await Insight.GetInsightAsync(householdId, deviceId);
        }
        finally
        {
            _insightLoading = false;
            StateHasChanged();
        }
    }

    private async Task ControlAsync(DeviceAction action)
    {
        if (_model is null || _busy)
        {
            return;
        }

        // The same hazard question the assistant asks over LINE, asked here too. Without
        // it the button would simply be refused by the control service, which reads as a
        // broken button rather than as a safeguard.
        var hazardAcknowledged = false;
        if (DeviceSafetyPolicy.CanEnergise(action) && _model.SafetyClass == "Guarded")
        {
            if (!await ConfirmHazardAsync())
            {
                return;
            }

            hazardAcknowledged = true;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var outcome = await Control.ExecuteAsync(
                _model.HouseholdId,
                _model.Alias,
                action,
                confidence: 1.0,
                originalText: $"[デバイス詳細] {_model.Alias} / {action}",
                source: CommandSource.Web,
                requestedByPersonId: null,
                aiResolvedModel: null,
                hazardAcknowledged: hazardAcknowledged);

            _notice = outcome.Message;
            _noticeKind = outcome.Status switch
            {
                CommandStatus.Succeeded => "ok",
                CommandStatus.Rejected => "blocked",
                _ => "warn"
            };

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> ConfirmHazardAsync()
    {
        var type = Enum.TryParse<DeviceType>(_model!.DeviceType, out var parsed) ? parsed : DeviceType.Plug;
        var checks = string.Join("\n", DeviceSafetyPolicy.HazardChecks(type).Select(c => $"・{c}"));
        var message =
            $"{_model.Name} は火や熱をあつかう機器です。周囲の安全を確認してからONにします。\n\n"
            + $"{checks}\n\n"
            + "実行するとご家族全員にお知らせが届きます。よろしいですか？";

        return await JS.InvokeAsync<bool>("confirm", message);
    }

    private async Task SaveNamingAsync()
    {
        if (_model is null || _busy || string.IsNullOrWhiteSpace(_nameDraft))
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var result = await Settings.UpdateNamingAsync(_model.DeviceId, _nameDraft, _roomDraft);
            _notice = result.Message;
            _noticeKind = result.Status == DeviceSettingsUpdateStatus.Updated ? "ok" : "blocked";
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UpdatePermissionAsync(
        bool remoteControlAllowed,
        bool treatAsSafeAppliance,
        bool blockRemoteTurnOn)
    {
        if (_model is null || _busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var result = await Settings.UpdatePermissionsAsync(
                _model.DeviceId,
                remoteControlAllowed,
                treatAsSafeAppliance,
                blockRemoteTurnOn: blockRemoteTurnOn);

            _notice = result.Message;
            _noticeKind = result.Status == DeviceSettingsUpdateStatus.Updated ? "ok" : "blocked";

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string DeviceTypeLabel(string type) => type switch
    {
        "Light" => "照明",
        "Fan" => "扇風機",
        "Plug" => "プラグ",
        "MotionSensor" => "人感センサー",
        "ContactSensor" => "開閉センサー",
        "Heater" => "ヒーター",
        "Kettle" => "電気ケトル",
        "Microwave" => "電子レンジ",
        "CookingDevice" => "調理機器",
        "DemoDevice" => "デモ機器",
        _ => type
    };

    private static string EventTypeLabel(string eventType) => eventType switch
    {
        "PowerState" => "電源状態の変化",
        "PowerChange" => "消費電力の変化",
        _ => eventType
    };

    private static string StateLabel(string state) => state.ToLowerInvariant() switch
    {
        "on" => "使用",
        "off" => "停止",
        "increased" => "電力↑",
        "decreased" => "電力↓",
        "active" => "動きあり",
        "inactive" => "動きなし",
        _ => state
    };

    private static string FormatLocal(DateTimeOffset? utc) =>
        utc is null ? "—" : HouseholdTime.ToLocal(utc.Value).ToString("M/d HH:mm");
}
