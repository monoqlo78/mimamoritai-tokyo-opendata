@page "/admin"
@rendermode InteractiveServer
@using MimamoriTai.Core.Application
@using MimamoriTai.Core.Domain
@using MimamoriTai.Web.Services
@implements IDisposable
@inject AdminConsoleService Console

<PageTitle>運用コンソール / 見守り隊</PageTitle>

<header class="topbar">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true">み</span>
        <div>
            <h1>運用コンソール</h1>
            <p>全世帯の稼働状況をまとめて確認します</p>
        </div>
    </div>
    <div class="topbar-actions">
        <button class="ghost small" @onclick="RefreshAsync" disabled="@_refreshing">
            @(_refreshing ? "更新中…" : "🔄 最新にする")
        </button>
        <a class="ghost small" href="/">← ダッシュボードに戻る</a>
    </div>
</header>

@if (_loading)
{
    <p class="muted">読み込み中…</p>
}
else if (_model is null)
{
    <section class="card">
        <h2>アクセスできません</h2>
        <p class="muted">
            この画面は運用管理者向けです。<code>Admin:Subjects</code> に
            <code>&lt;IdentityProvider&gt;:&lt;ExternalSubject&gt;</code> 形式でご自身の識別子を登録してください。
        </p>
    </section>
}
else
{
    @if (_model.IsDemoModeGrant)
    {
        <section class="card warn">
            <h2>デモモードで開いています</h2>
            <p class="muted">
                サインインが未構成のため、識別子を検証できません。誰でもこの画面を開ける状態です。
                本番配置では <code>Auth</code> を構成し、<code>Admin:Subjects</code> で管理者を明示してください。
            </p>
        </section>
    }

    <section class="kpi-grid">
        <div class="kpi">
            <span class="kpi-label">世帯</span>
            <span class="kpi-value">@_model.HouseholdCount</span>
            <span class="kpi-sub">うち本番 @_model.ProductionHouseholdCount</span>
        </div>
        <div class="kpi">
            <span class="kpi-label">利用者</span>
            <span class="kpi-value">@_model.UserCount</span>
            <span class="kpi-sub">登録アカウント</span>
        </div>
        <div class="kpi">
            <span class="kpi-label">デバイス</span>
            <span class="kpi-value">@_model.ActiveDeviceCount</span>
            <span class="kpi-sub">
                稼働中／登録 @_model.DeviceCount 台
            </span>
        </div>
        <div class="kpi">
            <span class="kpi-label">通知（@(_model.WindowDays)日）</span>
            <span class="kpi-value">@_model.AlertsInWindow</span>
            <span class="kpi-sub">失敗 @_model.FailedAlertsInWindow 件</span>
        </div>
        <div class="kpi @(_model.HouseholdsNeedingAttention > 0 ? "kpi-alert" : "")">
            <span class="kpi-label">要対応</span>
            <span class="kpi-value">@_model.HouseholdsNeedingAttention</span>
            <span class="kpi-sub">世帯</span>
        </div>
    </section>

    <section class="card">
        <h2>世帯一覧</h2>
        <div class="table-scroll">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>世帯</th>
                        <th>データ</th>
                        <th>家族</th>
                        <th>見守り対象</th>
                        <th>機器</th>
                        <th>最終イベント</th>
                        <th>SwitchBot</th>
                        <th>LINE</th>
                        <th>通知/失敗</th>
                        <th>直近リスク</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _model.Households)
                    {
                        <tr class="@(AdminConsoleService.NeedsAttention(row) ? "row-attention" : "")">
                            <td>
                                @row.Name
                                @if (AdminConsoleService.NeedsAttention(row))
                                {
                                    <span class="pill pill-alert">要対応</span>
                                }
                            </td>
                            <td>@(row.DataSourceMode == DataSourceMode.Sample ? "デモ" : "本番")</td>
                            <td>@row.MemberCount</td>
                            <td>@row.ResidentCount</td>
                            <td>
                                @row.ActiveDeviceCount
                                @if (row.DeviceCount != row.ActiveDeviceCount)
                                {
                                    <span class="muted small">／登録 @row.DeviceCount</span>
                                }
                            </td>
                            <td>@FormatTime(row.LastEventUtc)</td>
                            <td>
                                @SwitchBotLabel(row.SwitchBotStatus)
                                @if (!string.IsNullOrWhiteSpace(row.SwitchBotError))
                                {
                                    <br />
                                    <span class="muted small">@row.SwitchBotError</span>
                                }
                            </td>
                            <td>@row.ActiveLineRecipients</td>
                            <td>@row.AlertsInWindow / <span class="@(row.FailedAlertsInWindow > 0 ? "danger" : "")">@row.FailedAlertsInWindow</span></td>
                            <td>@(row.LatestRiskLevel is null ? "—" : RiskLabel(row.LatestRiskLevel.Value))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="card">
        <h2>直近の通知（@(_model.WindowDays)日・最大50件）</h2>
        @if (_model.RecentAlerts.Count == 0)
        {
            <p class="muted">対象期間に通知はありません。</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>日時</th>
                            <th>世帯</th>
                            <th>リスク</th>
                            <th>スコア</th>
                            <th>理由</th>
                            <th>結果</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var alert in _model.RecentAlerts)
                        {
                            <tr>
                                <td>@FormatTime(alert.SentAtUtc)</td>
                                <td>@alert.HouseholdName</td>
                                <td>@RiskLabel(alert.RiskLevel)</td>
                                <td>@alert.Score</td>
                                <td>@alert.Reason</td>
                                <td>
                                    @if (alert.Success)
                                    {
                                        <span class="pill">成功</span>
                                    }
                                    else
                                    {
                                        <span class="pill pill-alert">失敗</span>
                                        @if (!string.IsNullOrWhiteSpace(alert.Error))
                                        {
                                            <br />

                                            <span class="muted small">@alert.Error</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <h2>AI 利用状況（@(_model.WindowDays)日）</h2>
        @if (_model.AiUsage.Count == 0)
        {
            <p class="muted">対象期間に AI 呼び出しはありません。</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ルーター</th>
                            <th>モデル</th>
                            <th>件数</th>
                            <th>失敗</th>
                            <th>平均応答</th>
                            <th>直近の失敗理由</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usage in _model.AiUsage)
                        {
                            <tr>
                                <td>@usage.Router</td>
                                <td>@usage.ResolvedModel</td>
                                <td>@usage.Requests</td>
                                <td class="@(usage.Failures > 0 ? "danger" : "")">@usage.Failures</td>
                                <td>@usage.AverageDurationMs.ToString("F0") ms</td>
                                <td class="small">@(usage.LastError ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <p class="muted small">
        この表の内容は <strong>@FormatTime(_model.GeneratedAtUtc)</strong> 時点のものです（日本時間）。
        画面を開いたままにしていても自動では変わらないため、@(AutoRefreshSeconds)秒ごとに読み直しています。
        時刻はすべて日本時間で表示しています。
    </p>
}

@code {
    /// <summary>
    /// An operations console that silently keeps showing the moment it was opened is worse
    /// than no console: an operator reads a device count from last night and concludes the
    /// second plug never registered. So it reloads on a timer, and says when it last did.
    /// </summary>
    private const int AutoRefreshSeconds = 60;

    private AdminConsoleModel? _model;
    private bool _loading = true;
    private bool _refreshing;
    private Timer? _autoRefresh;

    protected override async Task OnInitializedAsync()
    {
        _model = await Console.LoadAsync();
        _loading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _model is null)
        {
            return;
        }

        _autoRefresh = new Timer(
            _ => _ = InvokeAsync(RefreshAsync),
            null,
            TimeSpan.FromSeconds(AutoRefreshSeconds),
            TimeSpan.FromSeconds(AutoRefreshSeconds));
    }

    private async Task RefreshAsync()
    {
        if (_refreshing)
        {
            return;
        }

        _refreshing = true;
        StateHasChanged();

        try
        {
            _model = await Console.LoadAsync();
        }
        finally
        {
            _refreshing = false;
            StateHasChanged();
        }
    }

    public void Dispose() => _autoRefresh?.Dispose();

    /// <summary>
    /// Everything else in the app speaks 日本時間. A console in UTC invites an operator to
    /// compare 08/14 10:18 here against 08/14 19:18 on the dashboard and call it a bug.
    /// </summary>
    private static string FormatTime(DateTimeOffset? value) =>
        value is null ? "—" : HouseholdTime.ToLocal(value.Value).ToString("MM/dd HH:mm");

    private static string SwitchBotLabel(SwitchBotConnectionStatus? status) => status switch
    {
        null => "未設定",
        SwitchBotConnectionStatus.NotConfigured => "未設定",
        SwitchBotConnectionStatus.Connected => "接続済み",
        SwitchBotConnectionStatus.Error => "エラー",
        _ => status.Value.ToString()
    };

    private static string RiskLabel(RiskLevel level) => level switch
    {
        RiskLevel.Low => "低",
        RiskLevel.Medium => "中",
        RiskLevel.High => "高",
        _ => level.ToString()
    };
}
