    /// <summary>
    /// Button presses go through the same DeviceControlService as chat commands, so the
    /// safety policy and the DeviceCommand audit trail apply identically. The UI never
    /// gets a privileged path around the guard rails.
    /// </summary>
    private async Task<bool> ConfirmHazardAsync(DeviceCard card)
    {
        var type = Enum.TryParse<DeviceType>(card.DeviceType, out var parsed) ? parsed : DeviceType.Plug;
        var checks = string.Join("\n", DeviceSafetyPolicy.HazardChecks(type).Select(c => $"・{c}"));
        var message =
            $"{card.Name} は火や熱をあつかう機器です。周囲の安全を確認してからONにします。\n\n"
            + $"{checks}\n\n"
            + "実行するとご家族全員にお知らせが届きます。よろしいですか？";

        return await JS.InvokeAsync<bool>("confirm", message);
    }

    private async Task ControlAsync(string alias, DeviceAction action)
    {
        if (_model is null || _busy)
        {
            return;
        }

        var card = _model.Devices.FirstOrDefault(d => d.Alias == alias);
        var hazardAcknowledged = false;
        if (card is not null && DeviceSafetyPolicy.CanEnergise(action) && card.SafetyClass == "Guarded")
        {
            if (!await ConfirmHazardAsync(card))
            {
                return;
            }

            hazardAcknowledged = true;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var outcome = await Control.ExecuteAsync(
                _model.HouseholdId,
                alias,
                action,
                confidence: 1.0,
                originalText: $"[ボタン操作] {alias} / {action}",
                source: CommandSource.Web,
                requestedByPersonId: null,
                aiResolvedModel: null,
                hazardAcknowledged: hazardAcknowledged);

            _notice = outcome.Message;
            _noticeKind = outcome.Status switch
            {
                CommandStatus.Succeeded => "ok",
                CommandStatus.Rejected => "blocked",
                _ => "warn"
            };

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartEditing(DeviceCard device)
    {
        _editingDeviceId = device.Id;
        _editNameDraft = device.Name;
        _editRoomDraft = device.Room;
    }

    private void CancelEditing()
    {
        _editingDeviceId = null;
