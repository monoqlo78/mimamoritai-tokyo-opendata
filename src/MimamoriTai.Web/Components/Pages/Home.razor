    // ---- Trend charts -------------------------------------------------------
    // All three read the daily figures the dashboard already loads, so drawing them
    // costs no extra query. Today is highlighted so the family can see at a glance
    // whether today stands out from the fortnight behind it.

    /// <summary>
    /// The headline chart. A plug left in the wall barely ever switches, so a chart of
    /// on/off events sits flat through a day of real cooking and heating; the draw behind
    /// the socket is what actually moves. See <see cref="ActivityService.EnergyWh"/>.
    /// </summary>
    private IReadOnlyList<BarChartPoint> EnergyTrend() =>
        TrendPoints(d => d.EnergyWh);

    private bool _energyBreakdownOpen;

    private void OpenEnergyBreakdown() => _energyBreakdownOpen = true;

    private void CloseEnergyBreakdown() => _energyBreakdownOpen = false;

    /// <summary>
    /// Marks the hour in progress. Today's last bar is always half-finished, and without
    /// this it reads as the moment the house went quiet rather than as the clock catching up.
    /// </summary>
    private static int CurrentHour() => HouseholdTime.LocalTime(DateTimeOffset.UtcNow).Hour;

    private string UsualLabel() =>
        _model is null || _model.HourlyEnergy.UsualDayCount == 0
            ? "いつもの平均"
            : $"いつもの平均（{_model.HourlyEnergy.UsualDayCount}日）";

    private string DeviceLabel(Guid deviceId) =>
        _model?.Devices.FirstOrDefault(d => d.Id == deviceId)?.Name ?? "家電";

    private string HourlyAriaLabel()
    {
        if (_model is null)
        {
            return "今日の電気の使いかた：まだ記録がありません";
        }

        var parts = _model.HourlyEnergy.Today
            .Select((wh, hour) => (wh, hour))
            .Where(x => x.wh > 0)
            // The window starts at the newest reading's hour, not at midnight, so the bar
            // at index 0 is not 0時 -- reading the index out loud names the wrong hour.
            .Select(x => $"{(_model.HourlyEnergy.StartHour + x.hour) % 24}時台 {x.wh:0.#}ワットアワー");

        return parts.Any()
            ? $"今日の電気の使いかた：{string.Join("、", parts)}"
            : "今日の電気の使いかた：まだ記録がありません";
    }

    /// <summary>
    /// One recorded day is enough to draw. A single bar is honest about how little there is
    /// so far; hiding it behind "データがありません" would be less so. What waits for a second
    /// day is the wording of a trend - see the verdict badges.
    /// </summary>
    private bool HasTrendData() =>
        _model is not null && _model.Recent.Any(d => d.FirstActivityTime is not null);

    private TrendVerdict EnergyVerdict() =>
        TrendVerdicts.ForUsage(
            TodayValue(d => d.EnergyWh), Baseline(d => d.EnergyWh), HoursIntoToday())
        ?? EmptyVerdict;

    private TrendVerdict FirstMoveVerdict() =>
        TrendVerdicts.ForWakeUp(TodayClockHours(d => d.FirstPowerMoveTime),
            ClockBaseline(d => d.FirstPowerMoveTime)) ?? EmptyVerdict;

    private TrendVerdict SettledVerdict() =>
        TrendVerdicts.ForWakeUp(TodayClockHours(d => d.SettledTime),
            ClockBaseline(d => d.SettledTime)) ?? EmptyVerdict;

    /// <summary>How much of today has happened, so a quiet morning is not called a quiet day.</summary>
    private static double HoursIntoToday() =>
        HouseholdTime.LocalTime(DateTimeOffset.UtcNow).ToTimeSpan().TotalHours;

    /// <summary>No badge at all, rather than a hedge like "判定できません" on every card.</summary>
    private static readonly TrendVerdict EmptyVerdict = new(string.Empty, string.Empty);

    private double? TodayValue(Func<DailyActivity, double> value)
    {
        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);
        var match = _model?.Recent.LastOrDefault(d => d.Date == today);

        return match is null ? null : value(match);
    }

    /// <summary>
    /// The days before today, and only those with something recorded: a device that was
    /// offline for a week would otherwise drag the "usual" down to nothing.
    /// </summary>
    private IReadOnlyList<double> Baseline(Func<DailyActivity, double> value)
    {
        if (_model is null)
        {
            return [];
        }

        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);

        return [.. _model.Recent
            .Where(d => d.Date < today && d.FirstActivityTime is not null)
            .Select(value)];
    }

    private double? TodayClockHours(Func<DailyActivity, TimeOnly?> pick)
    {
        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);
        var match = _model?.Recent.LastOrDefault(d => d.Date == today);

        return match is not null && pick(match) is { } t ? t.ToTimeSpan().TotalHours : null;
    }

    private IReadOnlyList<double> ClockBaseline(Func<DailyActivity, TimeOnly?> pick)
    {
        if (_model is null)
        {
            return [];
        }

        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);

        return [.. _model.Recent
            .Where(d => d.Date < today && pick(d) is not null)
            .Select(d => pick(d)!.Value.ToTimeSpan().TotalHours)];
    }

    /// <summary>
    /// A time of day as hours past midnight, so a later one makes a taller bar. Days with
    /// nothing recorded stay at zero rather than being dropped: a missing morning is the
    /// single most important thing on this screen. The tooltip shows a real clock time,
    /// because "6.5時" is not how anyone reads one.
    /// </summary>
    private IReadOnlyList<ClockTrendPoint> ClockTrend(Func<DailyActivity, TimeOnly?> pick)
    {
        var days = TrendDays();
        if (days.Count == 0)
        {
            return [];
        }

        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);

        return [.. days.Select(d => new ClockTrendPoint(
            d.Date.ToString("M/d"),
            pick(d),
            d.Date == today))];
    }

    private IReadOnlyList<ClockTrendPoint> FirstMoveTrend() => ClockTrend(d => d.FirstPowerMoveTime);

    private IReadOnlyList<ClockTrendPoint> SettledTrend() => ClockTrend(d => d.SettledTime);

    private IReadOnlyList<BarChartPoint> TrendPoints(Func<DailyActivity, double> value)
    {
        var days = TrendDays();
        if (days.Count == 0)
        {
            return [];
        }

        var today = HouseholdTime.LocalDate(DateTimeOffset.UtcNow);

        return [.. days.Select(d =>
            new BarChartPoint(d.Date.ToString("M/d"), value(d), d.Date == today))];
    }

    /// <summary>
    /// The days worth charting: everything from the first day something was recorded.
    /// A household that signed up yesterday gets one bar rather than one bar preceded by
    /// thirteen empty ones - padding the start with days that pre-date the household
    /// would suggest a fortnight of silence that never actually happened.
    /// </summary>
    private IReadOnlyList<DailyActivity> TrendDays()
    {
        if (_model is null)
        {
            return [];
        }

        var first = _model.Recent
            .Select((d, i) => (Day: d, Index: i))
            .FirstOrDefault(x => x.Day.FirstActivityTime is not null);

        return first.Day is null ? [] : [.. _model.Recent.Skip(first.Index)];
    }

    /// <summary>Spells the series out for screen readers, which cannot read the bars.</summary>
    private string TrendAriaLabel(string title, Func<DailyActivity, int> value, string unit)
    {
        if (_model is null || _model.Recent.Count == 0)
        {
            return $"{title}：まだ記録がありません";
        }

        var parts = _model.Recent.Select(d => $"{d.Date:M月d日} {value(d)}{unit}");
        return $"{title}：{string.Join("、", parts)}";
    }

    private string EnergyAriaLabel()
    {
        if (_model is null || _model.Recent.Count == 0)
        {
            return "電気の使いかた：まだ記録がありません";
        }

        var parts = _model.Recent.Select(d => $"{d.Date:M月d日} {d.EnergyWh:0.#}ワットアワー");
        return $"電気の使いかた：{string.Join("、", parts)}";
    }

    private string ClockAriaLabel(string title, Func<DailyActivity, TimeOnly?> pick)
    {
        if (_model is null || _model.Recent.Count == 0)
        {
            return $"{title}：まだ記録がありません";
        }

        var parts = _model.Recent.Select(d =>
            $"{d.Date:M月d日} {pick(d)?.ToString("H\\:mm") ?? "記録なし"}");
        return $"{title}：{string.Join("、", parts)}";
    }

