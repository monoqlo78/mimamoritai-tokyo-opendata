    private async Task SaveNamingAsync()
    {
        if (_model is null || _busy || _editingDeviceId is not { } deviceId || string.IsNullOrWhiteSpace(_editNameDraft))
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
