            {
                CancelEditing();
            }

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private Task SendAsync() => SendCoreAsync(_input, CommandSource.Web, null, () => _input = string.Empty);

    /// <summary>
    /// Pushes what the family typed straight to the household's LINE.
    ///
    /// This panel used to hand the text to the assistant and print the answer on the page,
    /// which made it an exact duplicate of the 見守りAI card above it and, more seriously,
    /// meant "家族にLINEで送る" sent nothing to anybody's phone. The message is also written
    /// to the shared feed so the sender can see it left, rather than having to trust it.
    /// </summary>
    private async Task SendLineAsync()
    {
        if (_model is null || string.IsNullOrWhiteSpace(_lineInput) || _busy)
        {
            return;
        }

        _busy = true;
        var text = _lineInput.Trim();
        _lineInput = string.Empty;
        _lineNotice = null;
        _lineNoticeKind = string.Empty;
        StateHasChanged();

        try
        {
            var sender = _model.People.FirstOrDefault(p => p.Id == _lineSpeaker)?.DisplayName ?? "ご家族";
            var result = await LineRelay.SendAsync(_model.HouseholdId, sender, text);

            if (result.Outcome == LineRelayOutcome.Sent)
            {
                _lineNotice = $"LINEにお送りしました（{result.Delivered}件）";
                _lineNoticeKind = "ok";
            }
            else
            {
                _lineNotice = result.Explanation;
                _lineNoticeKind = "warn";
            }

            // Recorded even when the push failed: the family still said it, and a message
            // that vanishes without trace is worse than one that is marked undelivered.
            Db.FamilyMessages.Add(new FamilyMessage
            {
                HouseholdId = _model.HouseholdId,
                PersonId = _lineSpeaker,
                Source = CommandSource.Line,
                MessageType = MessageType.Text,
                Content = text,
                OccurredAtUtc = DateTimeOffset.UtcNow
            });
            await Db.SaveChangesAsync();

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SendCoreAsync(string message, CommandSource source, Guid? personId, Action clearInput)
    {
        if (_model is null || string.IsNullOrWhiteSpace(message) || _busy)
        {
            return;
        }

        _busy = true;
        _thinking = true;
        var text = message.Trim();
        clearInput();

        var author = personId is { } id
            ? _model.People.FirstOrDefault(p => p.Id == id)?.DisplayName ?? "家族"
            : "あなた";

        _chatLog.Add(new FeedItem(DateTimeOffset.UtcNow, author, text, false));
        StateHasChanged();

        try
        {
            var response = await Orchestrator.HandleAsync(
                new AssistantRequest(_model.HouseholdId, personId, text, source));

            // 答えを載せる前に消す。片付けを finally に任せると、返事とインジケーターが
            // 一瞬並んで表示される。
            _thinking = false;
            _chatLog.Add(new FeedItem(DateTimeOffset.UtcNow, "見守りAI", response.Reply, true));

            // 返事が出た瞬間にミマモの口を動かす。文字だけだと、誰が答えたのかが
            // 伝わりにくい。
            await SpeakMascotAsync(response.Reply);
            await ReloadAsync();
        }
        finally
        {
            _thinking = false;
            _busy = false;
        }
    }

    /// <summary>
    /// Mouth movement is decoration: if the browser has no WebGL, or the script has not
    /// loaded yet, the reply is already on screen and nothing here needs to be retried.
    /// </summary>
    private async Task SpeakMascotAsync(string reply)
    {
        try
        {
            await JS.InvokeVoidAsync("mimamoriMascot.speak", reply);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    /// <summary>
    /// Runs the same WatchAlertService the background poller and the /api/alerts/evaluate
    /// endpoint use, so the demo button shows a real dedup/cooldown decision, not a canned one.
    /// </summary>
    private async Task EvaluateAlertAsync()
    {
        if (_model is null || _busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var outcome = await AlertService.EvaluateAsync(_model.HouseholdId);

            _notice = outcome.Status switch
            {
                WatchAlertStatus.Sent => $"アラートを送信しました：{outcome.Message}",
                WatchAlertStatus.SendFailed =>
                    $"アラートの送信に失敗しました（{outcome.SendResult?.Error ?? "不明なエラー"}）。内容: {outcome.Message}",
                _ => outcome.Message
            };

            _noticeKind = outcome.Status switch
            {
                WatchAlertStatus.Sent => "ok",
                WatchAlertStatus.SendFailed => "blocked",
                WatchAlertStatus.SuppressedByCooldown => "warn",
                _ => "ok"
            };

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Syncs real provider devices (SwitchBot) into the Devices table via
    /// DeviceSyncService, mirroring the /api/devices/sync endpoint. Only meaningful
    /// when SwitchBot is configured; the button is disabled otherwise.
    /// </summary>
    private async Task SyncDevicesAsync()
    {
        if (_model is null || _busy || !_model.Integrations.SwitchBotConfigured)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var result = await DeviceSync.SyncAsync(_model.HouseholdId);

            _notice = $"実機の同期が完了しました（追加 {result.Added}／更新 {result.Updated}／無効化 {result.Deactivated}）。";
            _noticeKind = "ok";

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Publishes the most recent DeviceEvent rows to the Fabric Eventhouse real-time
    /// stream via IEventStreamPublisher, mirroring /api/stream/publish. Azure SQL
    /// remains the source of truth; this is purely for proving the streaming path.
    /// </summary>
    private async Task PublishToStreamAsync()
    {
        if (_model is null || _busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var recent = await Db.DeviceEvents
                .OrderByDescending(e => e.OccurredAtUtc)
                .Take(50)
                .ToListAsync();

            var deviceIds = recent.Select(e => e.DeviceId).Distinct().ToList();
            var devices = await Db.Devices.Where(d => deviceIds.Contains(d.Id)).ToDictionaryAsync(d => d.Id);

            var records = recent.Select(e =>
            {
                devices.TryGetValue(e.DeviceId, out var device);
                return new MimamoriTai.Core.Abstractions.DeviceEventRecord(
                    e.Id,
                    e.HouseholdId,
                    e.DeviceId,
                    device?.DisplayName ?? string.Empty,
                    device?.DisplayRoom ?? string.Empty,
                    device?.DeviceType.ToString() ?? string.Empty,
                    e.EventType,
                    e.State,
                    e.PowerWatts,
                    e.Source.ToString(),
                    e.OccurredAtUtc.UtcDateTime);
            }).ToList();

            var result = await StreamPublisher.PublishAsync(records);

            if (result.Success)
            {
                _notice = $"Fabricへの送信が完了しました（{result.PublishedCount} 件・{result.DurationMs}ms・{StreamPublisher.DisplayName}）。";
                _noticeKind = "ok";
            }
            else
            {
                _notice = $"Fabricへの送信に失敗しました（{result.Error}）。";
                _noticeKind = "warn";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SimulateAsync(string scenario)
    {
        if (_model is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var householdId = _model.HouseholdId;
            var dayStart = HouseholdTime.StartOfLocalDayUtc(HouseholdTime.LocalDate(DateTimeOffset.UtcNow));
            var devices = await Db.Devices.Where(d => d.HouseholdId == householdId).ToListAsync();

            if (scenario is "no_activity" or "normal_day")
            {
                var existing = await Db.DeviceEvents
                    .Where(e => e.HouseholdId == householdId && e.OccurredAtUtc >= dayStart)
                    .ToListAsync();
                Db.DeviceEvents.RemoveRange(existing);
            }

            if (scenario == "normal_day")
            {
                AddEvents(householdId, devices, dayStart,
                    ("bedroom-light", "on", 7 * 60),
                    ("bedroom-light", "off", 7 * 60 + 12),
                    ("living-light", "on", 7 * 60 + 20),
                    ("living-light", "off", 12 * 60),
                    ("living-light", "on", 18 * 60));
            }
            else if (scenario == "night_activity")
            {
                AddEvents(householdId, devices, dayStart,
                    ("living-light", "on", 2 * 60 + 10),
                    ("living-light", "off", 2 * 60 + 45),
                    ("bedroom-light", "on", 3 * 60 + 5),
                    ("bedroom-light", "off", 3 * 60 + 25));
            }

            await Db.SaveChangesAsync();
            _notice = scenario switch
            {
                "normal_day" => "通常の一日のデータに差し替えました。",
                "no_activity" => "今日の活動データを削除しました（活動なし異常）。",
                _ => "深夜帯の活動データを追加しました。"
            };
            _noticeKind = scenario == "normal_day" ? "ok" : "warn";
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void AddEvents(Guid householdId, List<Device> devices, DateTimeOffset dayStart,
        params (string Alias, string State, int Minutes)[] items)
    {
        foreach (var (alias, state, minutes) in items)
        {
            var device = devices.FirstOrDefault(d => d.Alias == alias) ?? devices.FirstOrDefault();
            if (device is null)
            {
                continue;
            }

            Db.DeviceEvents.Add(new DeviceEvent
            {
                HouseholdId = householdId,
                DeviceId = device.Id,
                EventType = "PowerState",
                State = state,
                PowerWatts = state == "on" ? 32.0 : 0.0,
                Source = EventSource.Simulator,
                OccurredAtUtc = dayStart.AddMinutes(minutes),
                ReceivedAtUtc = dayStart.AddMinutes(minutes)
            });
        }
    }

    private static string RiskLabel(RiskLevel level) => level switch
    {
        RiskLevel.High => "要確認",
        RiskLevel.Medium => "少し気になる",
        _ => "いつもどおり"
