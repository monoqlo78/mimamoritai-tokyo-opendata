@page "/"
@rendermode InteractiveServer
@using MimamoriTai.Core.Abstractions
@using MimamoriTai.Core.Application
@using MimamoriTai.Core.Domain
@using MimamoriTai.Web.Services
@using Microsoft.EntityFrameworkCore
@using MimamoriTai.Infrastructure.Data
@using MimamoriTai.Infrastructure.Auth
@using Microsoft.Extensions.Options
@inject DashboardService Dashboard
@inject AssistantOrchestrator Orchestrator
@inject DeviceControlService Control
@inject AppDbContext Db
@inject IWebHostEnvironment Env
@inject WatchAlertService AlertService
@inject DeviceSyncService DeviceSync
@inject DeviceSettingsService DeviceSettings
@inject HouseholdAccessService HouseholdAccess
@inject LineConversationRelay LineRelay
@inject IDataSourceContext DataSourceContext
@inject MimamoriTai.Core.Abstractions.IEventStreamPublisher StreamPublisher
@inject ICurrentUserAccessor CurrentUserAccessor
@inject IOptions<AuthOptions> AuthOptionsAccessor
@inject MimamoriTai.Infrastructure.Auth.AdminAccessService AdminAccess
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>CareRoute AI / 見守り隊</PageTitle>

<header class="topbar">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true">み</span>
        <div>
            <h1>見守り隊</h1>
            <p>離れて暮らす家族の、今日がわかる</p>
        </div>
    </div>
    <div class="topbar-actions">
        <a class="primary-link" href="/one-touch">かんたん操作</a>
        <a class="ghost small" href="/settings/family">家族の追加</a>
        <a class="ghost small" href="/settings/switchbot">SwitchBot設定</a>
        @if (AdminAccess.IsAdmin)
        {
            <a class="ghost small" href="/admin">運用コンソール</a>
        }
        @if (AuthOptionsAccessor.Value.IsConfigured)
        {
            @if (CurrentUserAccessor.Current is { } user)
            {
                <span class="user-name">@user.DisplayName さん</span>
                <a class="ghost small" href="/auth/logout">ログアウト</a>
            }
            else
            {
                <a class="ghost small" href="/auth/login?returnUrl=/">ログイン</a>
            }
        }
        else
        {
            <span class="source-badge">デモ</span>
        }
    </div>
    @if (_model is not null)
    {
        <div class="household-picker">
            <label class="picker-label" for="analytics-profile">表示データ</label>
            <select id="analytics-profile" class="datasource-select" @onchange="OnHouseholdSelectedAsync" disabled="@_busy">
                @foreach (var h in _households)
                {
                    <option value="@h.Id" selected="@(h.Id == _model.HouseholdId)">
                        @h.AnalyticsLabel
                    </option>
                }
            </select>
            <span class="source-badge">
                @(_model.DataSourceMode == DataSourceMode.Sample ? "デモ" : "実データ")
            </span>
            @if (!_households.Any(h => h.DataSourceMode == DataSourceMode.Production))
            {
                <button class="link-button" title="実際のSwitchBot機器を使った本番データのご家庭を作成し、同期します"
                        @onclick="StartProductionAsync" disabled="@_busy">
                    実機につなぐ
                </button>
            }
        </div>
    }
</header>

@if (_model is null)
{
    <p class="loading">読み込み中…</p>
}
else
{
    @if (_notice is not null)
    {
        <div class="notice notice-@_noticeKind" role="status" aria-live="polite">
            <span class="notice-icon">@(_noticeKind == "ok" ? "✓" : _noticeKind == "blocked" ? "⛔" : "⚠")</span>
            <span>@_notice</span>
            <button class="notice-close" @onclick="() => _notice = null" aria-label="閉じる">✕</button>
        </div>
    }

    @if (_busy)
    {
        <div class="busy-bar" role="status" aria-live="polite">処理中…</div>
    }

    <section class="status-card hero-card risk-@_model.Risk.Level.ToString().ToLowerInvariant()">
        @* WebGLが動く端末では3Dのミマモが立つ。動かない端末・読み込み失敗時は
           下の静止画がそのまま残るので、顔が消えることはない。 *@
        <div class="status-stage" aria-hidden="true">
            <div class="hero-mascot mascot-viewer"
                 data-mascot-frame="face"
                 data-mascot-greeting="@MascotGreeting(_model.Risk.Level)"
                 data-mascot-model="/models/mimamo-robot-opus-rigged.glb">
                <canvas></canvas>
                <img class="mascot-poster" src="/images/mimamo-avatar.png" alt="" />
            </div>
            <span class="status-badge">@RiskIcon(_model.Risk.Level)</span>
        </div>
        <div class="status-copy">
            <p class="eyebrow">@ResidentDisplayName(_model.ResidentName)の今日</p>
            <h2>@RiskLabel(_model.Risk.Level)</h2>
            <p class="status-reason">@_model.Risk.Reason</p>
            @if (_model.Heat is { } heat)
            {
                <p class="heat-note heat-@heat.Level.ToString().ToLowerInvariant()"
                   title="@heat.Attribution">
                    <span class="heat-pill">暑さ指数 @heat.Wbgt.ToString("0.#") @heat.LevelText</span>
                    <span class="heat-detail">
                        @heat.AreaName
                        @if (heat.TemperatureC is { } t)
                        {
                            @($" {t:0.#}℃")
                        }
                        @if (heat.HumidityPercent is { } h)
                        {
                            @($" 湿度{h:0}%")
                        }
                    </span>
                    @if (heat.Advice is { } heatAdvice)
                    {
                        <span class="heat-advice">@heatAdvice</span>
                    }
                    <span class="heat-source">@heat.Attribution</span>
                </p>
            }
            else if (_model.Cold is { } cold)
            {
                @* Winter has no 暑さ指数 to show -- WBGT is only published from late April
                   to late October -- so the same card falls back to the year-round
                   observation rather than going blank for five months. *@
                <p class="heat-note cold-@cold.Level.ToString().ToLowerInvariant()"
                   title="@cold.Attribution">
                    <span class="heat-pill">気温 @cold.TemperatureC.ToString("0.#")℃ @cold.LevelText</span>
                    <span class="heat-detail">
                        @cold.AreaName
                        @if (cold.HumidityPercent is { } ch)
                        {
                            @($" 湿度{ch:0}%")
                        }
                    </span>
                    @if (cold.Advice is { } coldAdvice)
                    {
                        <span class="heat-advice">@coldAdvice</span>
                    }
                    <span class="heat-source">@cold.Attribution</span>
                </p>
            }
            @if (_model.TomorrowCold?.Advice is { } tomorrowAdvice)
            {
                @* Said the evening before, because warming a changing room is something
                   you can only do before the cold morning, not during it. *@
                <p class="heat-note cold-forecast" title="@_model.TomorrowCold.Attribution">
                    <span class="heat-pill">
                        あす朝の最低 @_model.TomorrowCold.MinTemperatureC.ToString("0.#")℃
                    </span>
                    <span class="heat-advice">@tomorrowAdvice</span>
                    <span class="heat-source">@_model.TomorrowCold.Attribution</span>
                </p>
            }
        </div>
        <button class="secondary-button" title="現在の状態を再評価し、必要であればLINEに通知します"
                @onclick="EvaluateAlertAsync" disabled="@_busy">
            状態を確認
        </button>
    </section>

    <section class="today-summary" aria-label="今日の活動">
        <div class="summary-item">
            <span>電気が動きはじめた</span>
            <strong>@(_model.Today.FirstPowerMoveTime?.ToString("HH\\:mm") ?? "まだありません")</strong>
        </div>
        <div class="summary-item">
            <span>最後に電気が動いた</span>
            <strong>@(_model.Today.SettledTime?.ToString("HH\\:mm") ?? "まだありません")</strong>
        </div>
        <div class="summary-item">
            <span>今日の電気</span>
            <strong>@_model.Today.EnergyWh.ToString("0.#") Wh</strong>
        </div>
    </section>

    <section class="card trend-card" aria-label="最近の推移">
        <div class="section-head">
            <div>
                <p class="eyebrow">最近の推移</p>
                <h2>いつもと比べてどうか</h2>
            </div>
            <span class="summary-meta">下の2つは直近@(TrendDays().Count)日間</span>
        </div>

        @if (!HasTrendData())
        {
            @* A brand-new household has a fortnight of empty days. Fourteen flat bars would
               read as "nothing has ever happened", which is exactly the alarming message
               this screen must not send by accident. *@
            <p class="trend-empty">記録がたまると、ここに数日分の移り変わりが出ます。<br />今日の様子は上のカードでご覧ください。</p>
        }
        else
        {
            @* The day laid out on the clock. A daily total says how much electricity was
               used but not whether the day had its usual shape, and the shape is what
               notices somebody who never got up. *@
            <button type="button" class="day-profile-open" @onclick="OpenEnergyBreakdown"
                    aria-haspopup="dialog"
                    title="家電ごとの内わけを見る">
                <DayProfileChart Hours="_model.HourlyEnergy.Today" Usual="_model.HourlyEnergy.Usual"
                                 Caption="この24時間の電気の使いかた"
                                 StartHour="_model.HourlyEnergy.StartHour"
                                 Badge="@EnergyVerdict().Text" BadgeClass="@EnergyVerdict().Class"
                                 CurrentHour="CurrentHour()"
                                 UsualLabel="@UsualLabel()"
                                 AriaLabel="@HourlyAriaLabel()" />
                <span class="day-profile-hint">家電ごとの内わけを見る</span>
            </button>

            <div class="trend-grid two">
                <div class="trend-item">
                    <ClockTrendChart Points="FirstMoveTrend()" Caption="電気が動きはじめた時間"
                                     Badge="@FirstMoveVerdict().Text" BadgeClass="@FirstMoveVerdict().Class"
                                     AriaLabel="@ClockAriaLabel("電気が動きはじめた時間", d => d.FirstPowerMoveTime)" />
                </div>
                <div class="trend-item">
                    <ClockTrendChart Points="SettledTrend()" Caption="電気が静かになった時間"
                                     Badge="@SettledVerdict().Text" BadgeClass="@SettledVerdict().Class"
                                     AriaLabel="@ClockAriaLabel("電気が静かになった時間", d => d.SettledTime)" />
                </div>
            </div>
            <p class="trend-note">上のグラフは、いちばん新しい記録を右はしにして、そこから24時間さかのぼって時間ごとに並べたものです。線はいつもの平均で、棒が線から離れているほど、いつもと違う1日です。その下の2つは、その日はじめて電気が動いた時間と、最後に動いた時間を、日ごとの点で並べたものです。記録がない日は点がありません。</p>
        }
    </section>

@if (_energyBreakdownOpen && _model is not null)
{
    @* Which appliance moved is the next question a family asks after "today looks
       different", and answering it inside the same card would bury the day itself. *@
    <div class="modal-backdrop" @onclick="CloseEnergyBreakdown">
        <div class="modal-panel" role="dialog" aria-modal="true" aria-label="家電ごとの電気の使いかた"
             @onclick:stopPropagation="true">
            <div class="modal-head">
                <h2>家電ごとの電気の使いかた</h2>
                <button type="button" class="modal-close" @onclick="CloseEnergyBreakdown"
                        aria-label="閉じる">×</button>
            </div>
            @if (_model.HourlyEnergy.TodayByDevice.Count == 0)
            {
                <p class="muted">今日はまだ、電気の量が記録されていません。</p>
            }
            else
            {
                <div class="modal-body">
                    @foreach (var device in _model.HourlyEnergy.TodayByDevice)
                    {
                        <DayProfileChart Hours="device.Hours"
                                         StartHour="_model.HourlyEnergy.StartHour"
                                         Caption="@($"{DeviceLabel(device.DeviceId)}（{device.TotalWh:0.#}Wh）")"
                                         CurrentHour="CurrentHour()"
                                         ShowLegend="false"
                                         Class="compact"
                                         AriaLabel="@($"{DeviceLabel(device.DeviceId)}の今日の電気の使いかた")" />
                    }
                </div>
            }
        </div>
    </div>
}

    <section class="primary-grid">
        <article class="card assistant-card">
            <div class="section-head">
                <div class="assistant-head">
                    @* 顔だけだと誰に話しかけているのか分かりにくいので、ここは全身で立たせる。
                       上のカードと同じGLBなので、読み込みは1回で済む。 *@
                    <div class="assistant-mascot mascot-viewer"
                         aria-hidden="true"
                         data-mascot-greeting="@MascotGreeting(_model.Risk.Level)"
                         data-mascot-model="/models/mimamo-robot-opus-rigged.glb">
                        <canvas></canvas>
                        <img class="mascot-poster" src="/images/mimamo-robot-opus.png" alt="" />
                    </div>
                    <div>
                        <p class="eyebrow">見守りAI</p>
                        <h2>気になることを聞いてください</h2>
                    </div>
                </div>
                @if (_chatLog.Count > 0)
                {
                    <button class="link-button" @onclick="() => _chatLog.Clear()" disabled="@_busy">会話を消す</button>
                }
            </div>
            @* Newest first in the DOM, flipped back by `flex-direction: column-reverse`.
               That is what keeps the latest exchange in view: a reversed column anchors
               its scroll to the newest child, so a long conversation opens where it
               ended instead of at the first question, and it stays there after every
               re-render without a scroll-to-bottom script. *@
            <div class="chat-log">
                @if (_thinking)
                {
                    @* 答えが出るまで数秒かかることがある。無音のまま待たせると、
                       押せていないのかと思って何度も押してしまう。 *@
                    <div class="chat-line ai thinking" role="status" aria-live="polite">
                        <span class="author">見守りAI</span>
                        <span class="text">
                            <span class="thinking-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                            <span class="thinking-label">考えています…</span>
                        </span>
                    </div>
                }
                @foreach (var line in Enumerable.Reverse(_chatLog))
                {
                    <div class="chat-line @(line.IsAi ? "ai" : "user")">
                        <span class="author">@line.Author</span>
                        <span class="text">@line.Content</span>
                    </div>
                }
                @if (_chatLog.Count == 0)
                {
                    <p class="muted empty">今日の様子や家電の状態を、いつもの言葉で聞けます。</p>
                }
            </div>
            <div class="chat-input">
                <input @bind="_input" @bind:event="oninput" @onkeydown="OnKeyDown"
                       placeholder="例：今日のお母さんの様子は？" disabled="@(_busy || _listening)" />
                @if (_speechSupported)
                {
                    <button class="mic-button @(_listening ? "listening" : null)"
                            @onclick="ToggleListeningAsync" disabled="@_busy"
                            title="@(_listening ? "聞き取りをやめる" : "話しかけて入力する")"
                            aria-label="@(_listening ? "聞き取りをやめる" : "話しかけて入力する")">
                        @(_listening ? "■" : "🎤")
                    </button>
                }
                <button @onclick="SendAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_input))">聞く</button>
            </div>
            @if (_listening)
            {
                <p class="listening-hint" role="status" aria-live="polite">お話しください…（例：「リビングの電気を消して」）</p>
            }
            <div class="quick">
                <button class="suggestion" @onclick="@(() => SendSampleAsync("今日のお母さんどう？"))" disabled="@_busy">今日の様子は？</button>
                <button class="suggestion" @onclick="@(() => SendSampleAsync("今日最初に活動したのは何時？"))" disabled="@_busy">最初に動いた時間は？</button>
                <button class="suggestion" @onclick="@(() => SendSampleAsync("リビングのライトは今ついてる？"))" disabled="@_busy">ライトはついてる？</button>
            </div>
        </article>

        <article class="card activity-card">
            <p class="eyebrow">最近の動き</p>
            <h2>家の中の様子</h2>
            @if (_model.Timeline.Count == 0)
            {
                <p class="empty-state">まだ記録がありません</p>
            }
            else
            {
                <ul class="timeline">
                @foreach (var item in _model.Timeline.Take(6))
                {
                    <li>
                        <span class="time">@FormatLocal(item.OccurredAtUtc)</span>
                        <span>@item.DeviceName</span>
                        <span class="state @item.State">@StateLabel(item.State)</span>
                    </li>
                }
                </ul>
            }
        </article>
    </section>

    <details class="detail-panel">
        <summary>
            <span>家電の状態</span>
            <span class="summary-meta">@_model.Devices.Count 台</span>
        </summary>
        <div class="detail-content device-grid">
            @foreach (var device in _model.Devices)
            {
                var d = device;
                <div class="device-card @(d.IsStateKnown && d.IsOn && !d.IsStandingBy() ? "on" : "off") @(d.SafetyClass == "Restricted" ? "restricted" : "")">
                    <div class="device-head">
                        <div>
                            <strong>@d.Name</strong>
                            <span class="device-room">@d.Room</span>
                        </div>
                        <span class="state-pill @(d.IsStateKnown && d.IsOn && !d.IsStandingBy() ? "on" : "")">@StateLabel(d)</span>
                    </div>
                    @if (d.IsStandingBy())
                    {
                        <p class="standby-note">スイッチは入っていますが、電気は使われていません</p>
                    }
                    <p class="muted">最終利用 @FormatLocal(d.LastUsedUtc) ・ 今日 @d.TodayUsageCount 回</p>
                    <div class="device-actions">
                        <button class="secondary-button"
                                title="@(d.SafetyClass switch { "Restricted" => "この機器は遠隔でONにしない設定です", "Guarded" => "周囲の安全を確認したうえでONにします", _ => "ONにする" })"
                                @onclick="@(() => ControlAsync(d.Alias, DeviceAction.TurnOn))"
                                disabled="@_busy">つける</button>
                        <button class="secondary-button"
                                @onclick="@(() => ControlAsync(d.Alias, DeviceAction.TurnOff))"
                                disabled="@_busy">消す</button>
                    </div>
                    @if (d.SafetyClass == "Restricted")
                    {
                        <p class="restricted-note">安全のため、遠隔では消す操作だけできます</p>
                    }
                    else if (d.SafetyClass == "Guarded")
                    {
                        <p class="restricted-note">火や熱をあつかう機器です。ONにする前に周囲の確認をお願いします（ご家族全員に通知されます）</p>
                    }
                    @if (_model.DataSourceMode != DataSourceMode.Sample)
                    {
                        @if (_editingDeviceId == d.Id)
                        {
                            <div class="device-rename">
                                <label>
                                    <span>呼び名</span>
                                    <input type="text" maxlength="60" placeholder="リビングの電気"
                                           value="@_editNameDraft"
                                           disabled="@_busy"
                                           @oninput="@(e => _editNameDraft = e.Value?.ToString() ?? "")" />
                                </label>
                                <label>
                                    <span>部屋</span>
                                    <input type="text" maxlength="64" placeholder="寝室"
                                           value="@_editRoomDraft"
                                           disabled="@_busy"
                                           @oninput="@(e => _editRoomDraft = e.Value?.ToString() ?? "")" />
                                </label>
                                <div class="device-rename-actions">
                                    <button class="secondary-button"
                                            disabled="@(_busy || string.IsNullOrWhiteSpace(_editNameDraft))"
                                            @onclick="SaveNamingAsync">保存</button>
                                    <button class="link-button" @onclick="CancelEditing">やめる</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button class="link-button device-rename-open"
                                    disabled="@_busy"
                                    @onclick="@(() => StartEditing(d))">名前・部屋を直す</button>
                        }
                    }
                    <a class="link-button device-detail-link" href="@($"/devices/{d.Id}")">くわしく見る →</a>
                </div>
            }
        </div>
    </details>

    <details class="detail-panel">
        <summary>
            <span>家族との共有</span>
            <span class="summary-meta">LINE・メッセージ</span>
        </summary>
        <div class="detail-content secondary-grid">
            <div>
                <h3>見守り隊をLINEに追加</h3>
                <div class="line-add">
                    <img src="https://qr-official.line.me/gs/M_755ykcrx_GW.png"
                         alt="見守り隊 LINE公式アカウントの友だち追加QRコード" />
                    <div>
                        <p>スマートフォンではボタンを、パソコンではQRコードを使って追加できます。</p>
                        <a class="primary-link" href="https://line.me/R/ti/p/@@755ykcrx" target="_blank"
                           rel="noopener noreferrer">LINEで友だち追加</a>
                        <span class="line-basic-id">ID: @@755ykcrx</span>
                    </div>
                </div>
                <h3>家族にLINEで送る</h3>
                <p class="line-send-note">入力した文章を、そのままご家族のLINEにお送りします。AIは返事をしません。</p>
                <div class="line-controls">
                    <select @bind="_lineSpeaker" disabled="@_busy">
                        @foreach (var person in _model.People)
                        {
                            <option value="@person.Id">@person.DisplayName</option>
                        }
                    </select>
                    <input @bind="_lineInput" @bind:event="oninput" @onkeydown="OnLineKeyDown"
                           placeholder="そろそろ電話するね" disabled="@_busy" />
                    <button @onclick="SendLineAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_lineInput))">送る</button>
                </div>
                @if (!string.IsNullOrEmpty(_lineNotice))
                {
                    <p class="line-send-notice @_lineNoticeKind">@_lineNotice</p>
                }
            </div>
            <div>
                <h3>共有メッセージ</h3>
                @* Same reversed-column trick as the chat log: newest first in the DOM so
                   the card opens on the most recent message. A family checking in wants
                   the last thing that was said, not the first. *@
                <div class="feed">
                    @foreach (var item in Enumerable.Reverse(_model.Feed))
                    {
                        <div class="feed-item @(item.IsAi ? "ai" : "")">
                            <span class="author">@item.Author</span>
                            <span class="time">@FormatLocal(item.OccurredAtUtc)</span>
                            <p>@item.Content</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </details>

    <details class="detail-panel technical">
        <summary>
            <span>詳しい情報・デモ操作</span>
            <span class="summary-meta">開発者向け</span>
        </summary>
        <div class="detail-content secondary-grid">
            <div>
                <h3>接続状況</h3>
                <div class="integrations">
                    <span class="chip @(_model.Integrations.SwitchBotConfigured ? "on" : "mock")">データ @(_model.Integrations.SwitchBotConfigured ? "実機" : "デモ")</span>
                    <span class="chip @(_model.Integrations.OrcaRouterConfigured ? "on" : "mock")">AI @(_model.Integrations.OrcaRouterConfigured ? "接続済み" : "モック")</span>
                    <span class="chip @(_model.Integrations.FabricConfigured ? "on" : "mock")">Fabric @(_model.Integrations.FabricConfigured ? "接続済み" : "ローカル")</span>
                    <span class="chip @(_model.Integrations.LineConfigured ? "on" : "mock")">LINE @(_model.Integrations.LineConfigured ? "接続済み" : "モック")</span>
                </div>
                <p class="muted">AIモデル @(_model.LastResolvedModel ?? "未使用")</p>
                <h3>直近14日の活動</h3>
                <ul class="history">
                    @foreach (var day in _model.Recent.Reverse())
                    {
                        <li>
                            <span class="date">@day.Date.ToString("M/d")</span>
                            <span class="bar" style="width:@(Math.Min(day.DeviceUsageCount * 12, 120))px"></span>
                            <span class="muted">@day.DeviceUsageCount 回</span>
                        </li>
                    }
                </ul>
            </div>
            <div>
                @if (Env.IsDevelopment())
                {
                    <h3>リスク判定デモ</h3>
                    <div class="quick">
                        <button class="suggestion" @onclick="@(() => SimulateAsync("normal_day"))" disabled="@_busy">通常の一日</button>
                        <button class="suggestion danger" @onclick="@(() => SimulateAsync("no_activity"))" disabled="@_busy">活動なし</button>
                        <button class="suggestion danger" @onclick="@(() => SimulateAsync("night_activity"))" disabled="@_busy">深夜活動</button>
                    </div>
                }
                <h3>データ連携</h3>
                <div class="quick">
                    <button class="suggestion" @onclick="SyncDevicesAsync" disabled="@(_busy || !_model.Integrations.SwitchBotConfigured)">実機を同期</button>
                    <button class="suggestion" @onclick="PublishToStreamAsync" disabled="@_busy">Fabricへ送信</button>
                </div>
            </div>
        </div>
    </details>
}

@code {
    private sealed record SampleGroup(string Label, string Kind, string[] Samples);

    private static readonly SampleGroup[] SampleGroups =
    [
        new("家電を操作", "act",
        [
            "リビングのライトつけて",
            "リビングのライト消して",
            "扇風機つけて"
        ]),
        new("安全ガードレール（拒否デモ）", "danger",
        [
            "ストーブつけて",
            "ストーブ消して"
        ]),
        new("生活データに質問", "ask",
        [
            "今日のお母さんどう？",
            "今日最初に活動したのは何時？",
            "リビングのライトは今ついてる？"
        ])
    ];

    private static readonly string[] LineSamples =
    [
        "今日のお母さんどう？",
        "リビングのライトつけて",
        "ストーブつけて"
    ];

    private DashboardModel? _model;
    private readonly List<FeedItem> _chatLog = [];
    private string _input = string.Empty;
    private string _lineInput = string.Empty;
    private string? _lineNotice;
    private string _lineNoticeKind = string.Empty;
    private Guid? _lineSpeaker;
    private bool _busy;

    /// <summary>
    /// Narrower than <see cref="_busy"/> on purpose: only a question in flight shows the
    /// waiting indicator. A device button press should not make the assistant look busy.
    /// </summary>
    private bool _thinking;
    private string? _notice;
    private string _noticeKind = "ok";
    private IReadOnlyList<HouseholdSummary> _households = [];
    private const string SelectedHouseholdCookieName = "mimamori_household";

    // Inline rename, opened one card at a time: the family corrects the name where they
    // noticed it was wrong, without first having to find the detail page.
    private Guid? _editingDeviceId;
    private string _editNameDraft = string.Empty;
    private string _editRoomDraft = string.Empty;

    // Voice input: speaking is easier than typing for the people this app is for.
    // Recognition runs in the browser (Web Speech API); we only receive the text.
    private bool _speechSupported;
    private bool _listening;

    // 30s: the dashboard reads every appliance each tick, so it refreshes half as often
    // as the single-device detail page to stay well inside SwitchBot's daily API allowance.
    private static readonly TimeSpan LiveRefreshInterval = TimeSpan.FromSeconds(30);
    private readonly CancellationTokenSource _refreshCts = new();
    private readonly SemaphoreSlim _reloadGate = new(1, 1);
    private PeriodicTimer? _refreshTimer;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    /// <summary>
    /// Restores the last-selected household from a cookie once the interactive circuit
    /// is up. This intentionally runs only after the first render (never during static
    /// prerendering), so JS interop is always available here and no exception can occur.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        string? cookieValue = null;
        try
        {
            cookieValue = await JS.InvokeAsync<string?>("mimamoriUi.getCookie", SelectedHouseholdCookieName);
        }
        catch (JSException)
        {
            // JS interop can be transiently unavailable (e.g. circuit still negotiating);
            // fall back to the server-resolved default household silently.
        }

        if (Guid.TryParse(cookieValue, out var householdId) && householdId != _model?.HouseholdId)
        {
            await ReloadAsync(householdId);
            StateHasChanged();
        }

        // Appliances are also switched by hand at the wall, so the cards have to keep
        // themselves honest instead of freezing on whatever was true when the page opened.
        _refreshTimer = new PeriodicTimer(LiveRefreshInterval);
        _ = RefreshLoopAsync(_refreshTimer, _refreshCts.Token);

        // The 3D mascot is decoration. If WebGL is missing, the file 404s, or interop
        // is briefly unavailable, the still image underneath stays visible - so a
        // failure here must never surface to the family as an error.
        // mimamoriUi.initMascot logs the real reason to the browser console first
        // (including in production), so "the mascot is a still image" reports can be
        // told apart from "the animation is broken" without guesswork.
        //
        // The mascot lives inside the `_model is null` else-branch, so on the first
        // render it does not exist yet and this call finds nothing. That is fine:
        // init() also starts watching for hosts, and picks them up when they arrive.
        try
        {
            await JS.InvokeVoidAsync("mimamoriUi.initMascot");
        }
        catch (JSException)
        {
            // Keep the poster. The cause is already in the browser console.
        }

        // The mic button is only offered where the browser can actually honour it
        // (Safari and Firefox on some platforms cannot), so nobody taps a dead control.
        try
        {
            _speechSupported = await JS.InvokeAsync<bool>("mimamoriUi.speechSupported");
            if (_speechSupported)
            {
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // Interop still settling; the keyboard path is unaffected.
        }
    }

    /// <summary>
    /// Starts (or cancels) a single voice capture and puts the recognised words into the
    /// same text box the keyboard writes to, so the family can review and correct them
    /// before anything is sent. Voice never executes a command on its own - a mis-heard
    /// "電気を消して" should not silently switch off an appliance.
    /// </summary>
    private async Task ToggleListeningAsync()
    {
        if (_listening)
        {
            _listening = false;
            try
            {
                await JS.InvokeVoidAsync("mimamoriUi.stopListening");
            }
            catch (JSException)
            {
                // Nothing to stop.
            }

            return;
        }

        _listening = true;
        StateHasChanged();

        string? heard = null;
        try
        {
            heard = await JS.InvokeAsync<string>("mimamoriUi.listenOnce", "ja-JP");
        }
        catch (JSException)
        {
            // Microphone denied or unavailable: fall through and leave the box as it was.
        }
        finally
        {
            _listening = false;
        }

        if (!string.IsNullOrWhiteSpace(heard))
        {
            _input = heard.Trim();
        }

        StateHasChanged();
    }

    private async Task RefreshLoopAsync(PeriodicTimer timer, CancellationToken ct)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                // Never refresh mid-edit: it would overwrite what the family is typing,
                // and never while another action is running, because the shared DbContext
                // cannot serve two operations at once.
                if (_busy || _editingDeviceId is not null)
                {
                    continue;
                }

                await InvokeAsync(async () =>
                {
                    await ReloadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Page closed.
        }
        catch (ObjectDisposedException)
        {
            // Circuit torn down between ticks.
        }
    }

    public ValueTask DisposeAsync()
    {
        _refreshCts.Cancel();
        _refreshTimer?.Dispose();
        _refreshCts.Dispose();
        _reloadGate.Dispose();
        return ValueTask.CompletedTask;
    }

    /// <summary>
    /// Blazor renders - and therefore fires <see cref="OnAfterRenderAsync"/> - before the task
    /// returned by <see cref="OnInitializedAsync"/> has completed, and the 30 second refresh loop
    /// ticks on its own thread on top of that. Every one of those paths reaches the same scoped
    /// DbContext, which throws "a second operation was started on this context instance" the moment
    /// two of them overlap and takes the whole circuit down with it, leaving the family staring at
    /// "読み込み中...". Queueing the loads here is what keeps the page alive.
    /// </summary>
    private async Task ReloadAsync(Guid? householdId = null)
    {
        await _reloadGate.WaitAsync();
        try
        {
            await ReloadCoreAsync(householdId);
        }
        finally
        {
            _reloadGate.Release();
        }
    }

    private async Task ReloadCoreAsync(Guid? householdId)
    {
        _households = await HouseholdAccess.ListAccessibleAsync();

        var targetId = householdId ?? _model?.HouseholdId ?? await Dashboard.GetDefaultHouseholdIdAsync();
        if (targetId is null)
        {
            return;
        }

        var model = await Dashboard.LoadAsync(targetId.Value);
        if (model is null)
        {
            // Access denied (e.g. stale cookie pointing at someone else's household) or the
            // household no longer exists; fall back to the caller's own accessible default.
            targetId = await Dashboard.GetDefaultHouseholdIdAsync();
            model = targetId is null ? null : await Dashboard.LoadAsync(targetId.Value);
        }

        _model = model;
        _lineSpeaker ??= _model?.People.FirstOrDefault(p => p.Role == PersonRole.Family)?.Id;
    }

    private async Task OnHouseholdSelectedAsync(ChangeEventArgs e)
    {
        if (_busy || !Guid.TryParse(e.Value?.ToString(), out var householdId))
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            await ReloadAsync(householdId);
            await PersistSelectedHouseholdAsync(householdId);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Provisions (or reuses) the caller's own Production household, then immediately
    /// runs the existing device-sync path so real SwitchBot devices are imported right away.
    /// </summary>
    private async Task StartProductionAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        StateHasChanged();

        try
        {
            var householdId = await HouseholdAccess.EnsureProductionHouseholdAsync("わが家", CancellationToken.None);

            DataSourceContext.Mode = DataSourceMode.Production;
            DataSourceContext.HouseholdId = householdId;
            var result = await DeviceSync.SyncAsync(householdId);

            _notice = $"本番データを開始しました（追加 {result.Added}／更新 {result.Updated}／無効化 {result.Deactivated}）。";
            _noticeKind = "ok";

            await ReloadAsync(householdId);
            await PersistSelectedHouseholdAsync(householdId);
        }
        catch (InvalidOperationException ex)
        {
            // Connecting real hardware needs a signed-in owner, and an anonymous visitor
            // clicking this button used to take the whole circuit down with it — the page
            // froze rather than saying what was missing. Say it instead.
            _notice = ex.Message.Contains("signed-in", StringComparison.OrdinalIgnoreCase)
                ? "実機につなぐには、まずサインインしてください。"
                : $"実機につなげませんでした：{ex.Message}";
            _noticeKind = "warn";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PersistSelectedHouseholdAsync(Guid householdId)
    {
        try
        {
            await JS.InvokeVoidAsync("mimamoriUi.setCookie", SelectedHouseholdCookieName, householdId.ToString());
        }
        catch (JSException)
        {
            // Best-effort only: the dropdown still works for the rest of this session
            // even if persisting the cookie failed.
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
