    /// <summary>
    /// "使用中" is what tells the family someone is up and about, so it is reserved for an
    /// appliance that is actually drawing power. A plug left switched on with nothing
    /// running behind it says 待機中 instead.
    /// </summary>
    private static string StateLabel(DeviceCard d) =>
        !d.IsStateKnown ? "確認中"
        : d.IsStandingBy() ? "待機中"
