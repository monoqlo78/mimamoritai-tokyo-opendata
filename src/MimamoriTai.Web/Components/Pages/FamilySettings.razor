@page "/settings/family"
@rendermode InteractiveServer
@using MimamoriTai.Core.Abstractions
@using MimamoriTai.Core.Application
@inject HouseholdAccessService HouseholdAccess
@inject SwitchBotConnectionService ConnectionService
@inject LineLinkCodeService LineLinkCodeService
@inject ICurrentUserAccessor CurrentUserAccessor
@inject ILogger<FamilySettings> Logger
@inject HouseholdLocationService LocationService
@inject IJSRuntime JS

<PageTitle>家族の追加 / 見守り隊</PageTitle>

<header class="topbar">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true">み</span>
        <div>
            <h1>家族の追加</h1>
            <p>見守りの様子をLINEで受け取るご家族を追加します</p>
        </div>
    </div>
    <div class="topbar-actions">
        <a class="ghost small" href="/">← ダッシュボードに戻る</a>
        <a class="ghost small" href="/settings/switchbot">SwitchBot設定</a>
    </div>
</header>

@if (_anonymous)
{
    <div class="notice notice-warn" role="status" aria-live="polite">
        <span class="notice-icon">⚠</span>
        <span>この画面を利用するにはサインインが必要です。</span>
    </div>
}
else if (!_isOwner)
{
    <div class="notice notice-warn" role="status" aria-live="polite">
        <span class="notice-icon">⚠</span>
        <span>この設定を変更できるのは、ご家庭のオーナーのみです。</span>
    </div>
}
else
{
    <article class="card" id="family">
        <p class="eyebrow">ご家族の追加</p>
        <h2>LINEでお知らせを受け取る</h2>
        <p class="muted">
            ご家族を追加するには、ここで発行したコードを、ご本人のLINEから送っていただきます。
            見守り隊の公式LINEアカウントを友だち追加したあと、下のボタンでコードを発行し、
            LINEのトーク画面で「連携 123456」のように送信してください（123456の部分は発行されたコードに置き換えます）。
            コードは発行から10分間・1回のみ有効です。
        </p>

        @if (_lineNotice is not null)
        {
            <p class="notice-@_lineNoticeKind">@_lineNotice</p>
        }

        @if (_lineCode is not null)
        {
            <div class="line-code-display">
                <span class="line-code-value">連携 @_lineCode</span>
                <span class="muted">有効期限: @FormatLocal(_lineCodeExpiresAtUtc) まで</span>
            </div>
        }

        <div class="device-actions">
            <button class="secondary-button" @onclick="GenerateLineCodeAsync" disabled="@_lineBusy">
                連携コードを発行する
            </button>
        </div>
    </article>

    <article class="card" id="location">
        <p class="eyebrow">お住まいの地域</p>
        <h2>気象データを受け取る場所</h2>
        <p class="muted">
            熱中症や冷え込みのお知らせは、気象庁が公開している観測所（アメダス）の気温をもとにお送りします。
            東京都内でも場所によって数℃ちがうため、お住まいの区市町村を選んでおくと、お知らせがより正確になります。
        </p>

        @if (_locationNotice is not null)
        {
            <p class="notice-@_locationNoticeKind">@_locationNotice</p>
        }

        <p class="location-current">
            現在の設定：<strong>@(_areaName ?? _stationName ?? "東京（既定）")</strong>
            @if (_stationName is not null)
            {
                <span class="muted">（気象データの取得元：@_stationName 観測所@(_stationCode is null ? null : $" / {_stationCode}")）</span>
            }
        </p>

        <div class="location-picker">
            <label for="area-select">区市町村を選ぶ</label>
            <select id="area-select" @onchange="OnAreaSelectedAsync" disabled="@(_locationBusy || _areas.Count == 0)">
                <option value="">— 選択してください —</option>
                @foreach (var group in _areas.GroupBy(a => a.Group))
                {
                    <optgroup label="@group.Key">
                        @foreach (var area in group)
                        {
                            <option value="@area.Name" selected="@(area.Name == _areaName)">
                                @area.Name@(area.Station is { } s ? $"（{s.Name} 観測所）" : null)
                            </option>
                        }
                    </optgroup>
                }
            </select>
        </div>

        <div class="device-actions">
            <button class="secondary-button" @onclick="UseCurrentPositionAsync" disabled="@_locationBusy">
                📍 現在地から設定する
            </button>
        </div>

        @* Said plainly: there is no thermometer in most wards, so the honest thing is to
           name the station the reading actually comes from rather than imply otherwise. *@
        <p class="muted small">
            気温を観測しているアメダスは都内に数か所しかないため、お選びの区市町村にいちばん近い観測所の値をお届けします。
            位置情報はお使いの端末の中で最寄りの観測所を決めるためだけに使い、保存するのは区市町村名と観測所の名前・番号だけです。
            出典：気象庁「アメダス観測所一覧」
        </p>
    </article>
}

@code {
    private Guid _householdId;
    private bool _anonymous;
    private bool _isOwner;

    private string? _lineCode;
    private DateTimeOffset? _lineCodeExpiresAtUtc;
    private bool _lineBusy;
    private string? _lineNotice;
    private string _lineNoticeKind = "ok";

    private IReadOnlyList<HouseholdArea> _areas = [];
    private string? _areaName;
    private string? _stationCode;
    private string? _stationName;
    private bool _locationBusy;
    private string? _locationNotice;
    private string _locationNoticeKind = "ok";

    protected override async Task OnInitializedAsync()
    {
        var user = CurrentUserAccessor.Current;
        if (user is null)
        {
            _anonymous = true;
            return;
        }

        // Same resolution as the SwitchBot screen: the household a link code belongs to
        // must be the caller's own Production household, never a demo one, or the code
        // would connect a relative's LINE to seeded data.
        _householdId = await HouseholdAccess.EnsureProductionHouseholdAsync("わが家");
        _isOwner = await ConnectionService.IsOwnerAsync(_householdId, user.AppUserId);

        if (_isOwner)
        {
            await LoadLocationAsync();
        }
    }

    private async Task LoadLocationAsync()
    {
        try
        {
            _areas = await LocationService.ListAreasAsync();
            var (areaName, station) = await LocationService.GetAsync(_householdId);
            _areaName = areaName;
            _stationCode = station?.Code;
            _stationName = station?.Name;
        }
        catch (Exception ex)
        {
            // 気象庁 being unreachable must not take the whole settings page with it --
            // the LINE half above still has to work.
            Logger.LogWarning(ex, "AMeDAS station list unavailable for household {HouseholdId}.", _householdId);
            _areas = [];
        }
    }

    private async Task OnAreaSelectedAsync(ChangeEventArgs e)
    {
        if (e.Value as string is not { Length: > 0 } area || _locationBusy)
        {
            return;
        }

        await ApplyAsync(area, () => LocationService.SetByAreaAsync(_householdId, area));
    }

    private async Task UseCurrentPositionAsync()
    {
        if (_locationBusy)
        {
            return;
        }

        _locationBusy = true;
        _locationNotice = "現在地を確認しています…";
        _locationNoticeKind = "ok";
        StateHasChanged();

        GeoPosition? position = null;
        try
        {
            position = await JS.InvokeAsync<GeoPosition?>("mimamoriUi.getPosition");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Geolocation lookup failed.");
        }

        _locationBusy = false;

        if (position is null)
        {
            _locationNotice = "現在地を取得できませんでした。ブラウザの位置情報を許可するか、下の一覧から地域をお選びください。";
            _locationNoticeKind = "warn";
            StateHasChanged();
            return;
        }

        await ApplyAsync(
            area: null,
            () => LocationService.SetFromCoordinateAsync(_householdId, position.Latitude, position.Longitude));
    }

    private async Task ApplyAsync(string? area, Func<Task<AmedasStation?>> save)
    {
        _locationBusy = true;
        StateHasChanged();

        try
        {
            var station = await save();
            if (station is null)
            {
                _locationNotice = "地域を保存できませんでした。時間をおいて再度お試しください。";
                _locationNoticeKind = "warn";
            }
            else
            {
                _stationCode = station.Code;
                _stationName = station.Name;

                // A GPS fix does not say which ward it landed in, so the stored value is
                // read back rather than guessed at on screen.
                if (area is { Length: > 0 })
                {
                    _areaName = area;
                }
                else
                {
                    var (savedArea, _) = await LocationService.GetAsync(_householdId);
                    _areaName = savedArea;
                }

                _locationNotice = _areaName is { Length: > 0 }
                    ? $"お住まいの地域を「{_areaName}」に設定しました。気象データは{station.Name}観測所から受け取ります。"
                    : $"気象データを{station.Name}観測所から受け取るように設定しました。";
                _locationNoticeKind = "ok";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the AMeDAS station failed for household {HouseholdId}.", _householdId);
            _locationNotice = "地域を保存できませんでした。時間をおいて再度お試しください。";
            _locationNoticeKind = "warn";
        }
        finally
        {
            _locationBusy = false;
            StateHasChanged();
        }
    }

    private sealed record GeoPosition(double Latitude, double Longitude);

    private static string FormatLocal(DateTimeOffset? utc) =>
        utc is null ? "—" : HouseholdTime.ToLocal(utc.Value).ToString("M/d HH:mm");

    private async Task GenerateLineCodeAsync()
    {
        if (_lineBusy)
        {
            return;
        }

        _lineBusy = true;
        StateHasChanged();

        try
        {
            var generated = await LineLinkCodeService.GenerateCodeAsync(_householdId);
            _lineCode = generated.Code;
            _lineCodeExpiresAtUtc = generated.ExpiresAtUtc;
            _lineNotice = "コードを発行しました。LINEのトーク画面で送信してください。";
            _lineNoticeKind = "ok";
        }
        catch (Exception ex)
        {
            // Without this the exception tears down the Blazor circuit and the button
            // simply appears dead -- the user gets no feedback at all. Surface the
            // failure in place and keep the page usable.
            Logger.LogError(ex, "LINE link code generation failed for household {HouseholdId}.", _householdId);
            _lineCode = null;
            _lineCodeExpiresAtUtc = null;
            _lineNotice = $"コードを発行できませんでした（{ex.GetType().Name}）。時間をおいて再度お試しください。";
            _lineNoticeKind = "warn";
        }
        finally
        {
            _lineBusy = false;
            StateHasChanged();
        }
    }
}
